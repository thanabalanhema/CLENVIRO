<script id="clx-final-correction-js">
(function(){
  'use strict';

  const KEY='clenviro_demo_waste_trend_v2';
  const DEFAULT_TREND=[
    {date:'2026-10-01',generated:12.4,collected:10.2,processed:7.1},
    {date:'2026-10-02',generated:13.1,collected:10.9,processed:7.5},
    {date:'2026-10-03',generated:12.7,collected:10.7,processed:7.8},
    {date:'2026-10-04',generated:14.0,collected:11.9,processed:8.3},
    {date:'2026-10-05',generated:14.6,collected:12.8,processed:8.9},
    {date:'2026-10-06',generated:15.2,collected:13.7,processed:9.6},
    {date:'2026-10-07',generated:15.8,collected:14.4,processed:10.1}
  ];

  function safeNum(v){const n=Number(v);return Number.isFinite(n)&&n>=0?n:0;}
  function loadTrend(){
    try{
      const raw=localStorage.getItem(KEY);
      const a=raw?JSON.parse(raw):null;
      if(Array.isArray(a)&&a.length)return a;
    }catch(e){}
    return DEFAULT_TREND.map(x=>({...x}));
  }
  let TREND=loadTrend();

  function validateRow(r){
    r.generated=safeNum(r.generated);
    r.collected=Math.min(safeNum(r.collected),r.generated);
    r.processed=Math.min(safeNum(r.processed),r.collected);
    return r;
  }

  window.clxSaveTrend=function(){
    TREND=TREND.map(validateRow);
    localStorage.setItem(KEY,JSON.stringify(TREND));
    clxRenderEditor();
    clxRenderAllCharts();
    if(typeof showToast==='function')showToast('💾','Demo waste trend saved locally.');
  };
  window.clxResetTrend=function(){
    TREND=DEFAULT_TREND.map(x=>({...x}));
    localStorage.removeItem(KEY);
    clxRenderEditor();
    clxRenderAllCharts();
    if(typeof showToast==='function')showToast('↺','Demo trend reset.');
  };
  window.clxAddTrendDay=function(){
    const last=TREND[TREND.length-1]||DEFAULT_TREND[DEFAULT_TREND.length-1];
    const d=new Date(last.date+'T00:00:00');
    d.setDate(d.getDate()+1);
    const iso=d.toISOString().slice(0,10);
    TREND.push({date:iso,generated:16.2,collected:14.9,processed:10.5});
    clxRenderEditor();
    clxRenderAllCharts();
  };
  window.clxUpdateTrend=function(i,key,val){
    if(!TREND[i])return;
    TREND[i][key]=val;
    TREND[i]=validateRow(TREND[i]);
    clxRenderAllCharts();
  };

  function clxRenderEditor(){
    const el=document.getElementById('clx-trend-grid');
    if(!el)return;
    el.innerHTML='<div class="clx-editor-row" style="font-weight:800;color:#111827"><div>Date</div><div>Generated (T)</div><div>Collected (T)</div><div>Processed (T)</div></div>'+
      TREND.map((r,i)=>`<div class="clx-editor-row">
        <input type="date" value="${r.date}" onchange="TREND[${i}].date=this.value;clxRenderAllCharts()">
        <input type="number" min="0" step="0.1" value="${r.generated}" oninput="clxUpdateTrend(${i},'generated',this.value)">
        <input type="number" min="0" step="0.1" value="${r.collected}" oninput="clxUpdateTrend(${i},'collected',this.value)">
        <input type="number" min="0" step="0.1" value="${r.processed}" oninput="clxUpdateTrend(${i},'processed',this.value)">
      </div>`).join('');
  }

  function esc(v){return String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}

  function makeLineChart(hostId, labels, series, yLabel){
    const host=document.getElementById(hostId); if(!host)return;
    const W=900,H=245,L=48,R=16,T=18,B=34,iw=W-L-R,ih=H-T-B;
    const all=series.flatMap(x=>x.data); const max=Math.max(1,Math.ceil(Math.max(...all)*1.12));
    const x=i=>L+(labels.length===1?iw/2:(i/(labels.length-1))*iw);
    const y=v=>T+ih-(v/max)*ih;
    let svg=`<svg class="clx-chart-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">`;
    for(let k=0;k<=4;k++){const v=max*k/4, yy=y(v);svg+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#E5EAF0" stroke-width="1"/><text x="${L-7}" y="${yy+4}" text-anchor="end" font-size="10" fill="#64748B">${v.toFixed(1)}</text>`;}
    series.forEach((sr,si)=>{
      const pts=sr.data.map((v,i)=>`${x(i)},${y(v)}`).join(' ');
      svg+=`<polyline points="${pts}" fill="none" stroke="${sr.color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;
      sr.data.forEach((v,i)=>{svg+=`<circle cx="${x(i)}" cy="${y(v)}" r="3.5" fill="#fff" stroke="${sr.color}" stroke-width="2"/>`;});
    });
    labels.forEach((lab,i)=>{svg+=`<text x="${x(i)}" y="${H-10}" text-anchor="middle" font-size="10" fill="#64748B">${esc(lab)}</text>`;});
    svg+=`</svg><div class="clx-chart-legend">${series.map(sr=>`<span><i class="clx-dot" style="background:${sr.color}"></i>${esc(sr.label)}</span>`).join('')}</div>`;
    host.innerHTML=svg;
  }

  function makeBarChart(hostId, labels, values, color, suffix){
    const host=document.getElementById(hostId); if(!host)return;
    const W=900,H=245,L=48,R=16,T=18,B=38,iw=W-L-R,ih=H-T-B,max=Math.max(1,Math.ceil(Math.max(...values)*1.15));
    const bw=Math.max(12,iw/Math.max(1,values.length)-10);
    let svg=`<svg class="clx-chart-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">`;
    for(let k=0;k<=4;k++){const v=max*k/4,yy=T+ih-(v/max)*ih;svg+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#E5EAF0"/><text x="${L-7}" y="${yy+4}" text-anchor="end" font-size="10" fill="#64748B">${v.toFixed(0)}</text>`;}
    values.forEach((v,i)=>{const xx=L+i*(iw/values.length)+(iw/values.length-bw)/2,hh=(v/max)*ih,yy=T+ih-hh;svg+=`<rect x="${xx}" y="${yy}" width="${bw}" height="${hh}" rx="4" fill="${color}"/><text x="${xx+bw/2}" y="${yy-5}" text-anchor="middle" font-size="9" fill="#334155">${v.toFixed(1)}${suffix||''}</text><text x="${xx+bw/2}" y="${H-12}" text-anchor="middle" font-size="10" fill="#64748B">${esc(labels[i])}</text>`;});
    svg+='</svg>';
    host.innerHTML=svg;
  }

  function hostify(canvasId){
    const c=document.getElementById(canvasId); if(!c)return null;
    let host=c.parentElement.querySelector('.clx-chart-host');
    if(!host){host=document.createElement('div');host.className='clx-chart-host';c.style.display='none';c.parentElement.appendChild(host);}
    return host.id || (host.id='clx-host-'+canvasId);
  }

  function ensureChartHosts(){
    ['chart-waste-trend','chart-efficiency-recycling','chart-composition','chart-overflow-complaints','chart-co2','chart-vehicle-util','chart-comparison'].forEach(hostify);
  }

  function renderKPIs(){
    const k=document.getElementById('an-kpi-grid'); if(!k)return;
    const totalG=TREND.reduce((a,r)=>a+r.generated,0), totalC=TREND.reduce((a,r)=>a+r.collected,0), totalP=TREND.reduce((a,r)=>a+r.processed,0);
    const eff=totalG?totalC/totalG*100:0, gap=totalG-totalC;
    k.innerHTML=[
      ['Waste Generated',totalG.toFixed(1)+' T','Selected demo period'],
      ['Waste Collected',totalC.toFixed(1)+' T','Selected demo period'],
      ['Collection Efficiency',eff.toFixed(1)+'%','Collected ÷ Generated'],
      ['Processing',totalP.toFixed(1)+' T','Selected demo period'],
      ['Collection Gap',gap.toFixed(1)+' T','Generated − Collected']
    ].map(x=>`<div class="kpi-card"><div class="kpi-label">${x[0]}</div><div class="kpi-value">${x[1]}</div><div class="kpi-meta">${x[2]}</div></div>`).join('');
  }

  function renderInsights(){
    const el=document.getElementById('an-insights'); if(!el)return;
    if(TREND.length<2){el.textContent='Add at least two days to calculate a trend.';return;}
    const first=TREND[0],last=TREND[TREND.length-1];
    const eff1=first.generated?first.collected/first.generated*100:0, eff2=last.generated?last.collected/last.generated*100:0;
    const gdelta=last.generated-first.generated, cdelta=last.collected-first.collected;
    el.innerHTML=[
      `Waste generated ${gdelta>=0?'increased':'decreased'} by <b>${Math.abs(gdelta).toFixed(1)} T</b> from ${first.date} to ${last.date}.`,
      `Waste collected ${cdelta>=0?'increased':'decreased'} by <b>${Math.abs(cdelta).toFixed(1)} T</b>; collection efficiency moved from <b>${eff1.toFixed(1)}%</b> to <b>${eff2.toFixed(1)}%</b>.`,
      `Processing reached <b>${last.processed.toFixed(1)} T</b> on the latest day, leaving <b>${Math.max(0,last.collected-last.processed).toFixed(1)} T</b> collected but not yet processed in this demo snapshot.`
    ].join('<br>');
  }

  function clxRenderAllCharts(){
    ensureChartHosts();
    renderKPIs();
    const labels=TREND.map(r=>r.date.slice(5));
    const g=TREND.map(r=>r.generated), c=TREND.map(r=>r.collected), p=TREND.map(r=>r.processed);
    makeLineChart('clx-host-chart-waste-trend',labels,[{label:'Generated (T)',data:g,color:'#D97706'},{label:'Collected (T)',data:c,color:'#008F72'},{label:'Processed (T)',data:p,color:'#16A34A'}]);
    const eff=TREND.map(r=>r.generated?r.collected/r.generated*100:0);
    makeLineChart('clx-host-chart-efficiency-recycling',labels,[{label:'Collection Efficiency %',data:eff,color:'#2563EB'}]);
    const last=TREND[0]||{generated:0};
    const comp=[last.generated*.52,last.generated*.27,last.generated*.12,last.generated*.05,last.generated*.04];
    makeBarChart('clx-host-chart-composition',['Wet','Dry','Plastic','E-waste','Hazardous'],comp,'#475569',' T');
    const gap=TREND.map(r=>Math.max(0,r.generated-r.collected));
    makeBarChart('clx-host-chart-overflow-complaints',labels,gap,'#DC2626',' T gap');
    const cum=[];let cc=0;TREND.forEach(r=>{cc+=Math.max(0,r.processed*.28);cum.push(cc);});
    makeLineChart('clx-host-chart-co2',labels,[{label:'Cumulative CO₂ Saved (T) — demo factor',data:cum,color:'#008F72'}]);
    const util=TREND.map(r=>r.generated?Math.min(100,r.collected/r.generated*100):0);
    makeLineChart('clx-host-chart-vehicle-util',labels,[{label:'Collection Utilization %',data:util,color:'#2563EB'}]);
    renderInsights();
  }

  // Expose so the existing analytics page can refresh it after selector changes.
  window.clxRenderAllCharts=clxRenderAllCharts;

  // Override the existing Chart-dependent analytics renderer with a deterministic,
  // offline-safe demo renderer. The existing government/state dataset remains untouched.
  window.anRender=function(){
    clxRenderAllCharts();
    if(typeof anRenderAIOpsMetrics==='function')anRenderAIOpsMetrics();
  };

  // Panchayat access: only Panchayat demo account defaults to this page.
  const originalShowPage=window.showPage;
  if(typeof originalShowPage==='function'){
    window.showPage=function(id,btn){
      if(typeof currentRole!=='undefined' && currentRole==='panchayat' && id!=='panchayat'){
        if(typeof showToast==='function')showToast('🔒','This account is restricted to the Panchayat Portal.');
        return;
      }
      if(id==='panchayat' && typeof currentRole!=='undefined' && currentRole!=='panchayat' && currentRole!=='admin'){
        if(typeof showToast==='function')showToast('🔒','Panchayat access requires a Panchayat account.');
        return;
      }
      return originalShowPage.apply(this,arguments);
    };
  }

  // Replace tiny/blank analytics canvas area after page is ready.
  function initFinalUI(){
    clxRenderEditor();
    clxRenderAllCharts();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(initFinalUI,300));
  else setTimeout(initFinalUI,300);

})();
</script>

