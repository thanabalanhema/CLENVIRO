 const rows=kind==="district"?D.districts:D.states;
 const fields=kind==="district"
  ?["id","state","district","generated","collected","processed","landfilled","source"]
  :["id","state","generated","collected","processed","landfilled","source"];
 const lines=[fields.join(",")].concat(rows.map(r=>fields.map(k=>`"${String(r[k]??"").replace(/"/g,'""')}"`).join(",")));
