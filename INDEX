// Light one-way link: GIS district click -> Analytics page, pre-selected.
// (Kept one-way per Phase 6 guidance — full bidirectional sync with the map
// isn't worth the added risk to existing GIS interactions for a prototype.)
function gisOpenDistrictAnalytics(district){
  showPage('analytics');
  document.querySelectorAll('.nav-btn').forEach(b=>{ if(b.textContent.trim()==='Analytics'||b.textContent.trim()==='City Stats') b.classList.add('active'); });
  setTimeout(()=>{
    if(typeof anInit === 'function') anInit();
    const stateSel = document.getElementById('an-state-select');
    const distSel = document.getElementById('an-district-select');
    if(stateSel){ stateSel.value = 'Tamil Nadu'; anRefreshDistrictOptions(); }
    if(distSel){ distSel.value = district; }
    if(typeof anRender === 'function') anRender();
  }, 80);
}

function gisHideInfoPanel(){
  const panel = document.getElementById('gis-info-panel');
  if(panel) panel.style.display = 'none';
}

// ============ GIS: SEARCH ============
function gisSearch(q){
  const box = document.getElementById('gis-search-results');
  q = (q||'').trim().toLowerCase();
  if(!q){ box.style.display='none'; box.innerHTML=''; return; }
  const results = [];
  GIS_INDIA_STATES.features.forEach(f => {
    if(f.properties.name.toLowerCase().includes(q)) results.push({name:f.properties.name, type:'state', layerData:f});
  });
  GIS_TN_DISTRICTS.features.forEach(f => {
    if(f.properties.name.toLowerCase().includes(q)) results.push({name:f.properties.name, type:'district (Tamil Nadu)', layerData:f});
  });
  if(!results.length){ box.style.display='block'; box.innerHTML = '<div class="gis-search-item" style="cursor:default;color:var(--text2);">No match</div>'; return; }
  box.innerHTML = results.slice(0,8).map((r,i) =>
    `<div class="gis-search-item" onclick="gisSearchGo(${i})">📍 ${r.name} <span style="color:var(--text2);font-size:10px;">— ${r.type}</span></div>`
  ).join('');
  box.style.display = 'block';
  window._gisSearchResults = results;
}
function gisSearchGo(i){
  const r = window._gisSearchResults[i];
  document.getElementById('gis-search-results').style.display='none';
  document.getElementById('gis-search').value = r.name;
  if(r.type === 'state'){
    if(r.name === 'Tamil Nadu'){ gisRenderTamilNadu(); }
    else {
      gisRenderIndia();
      const layer = L.geoJSON(r.layerData);
      try{ map.fitBounds(layer.getBounds(), {padding:[20,20]}); }catch(e){}
      showToast('🇮🇳', r.name + ' — district drill-down is prototyped for Tamil Nadu only');
    }
  } else {
    if(gisLevel !== 'tamilnadu' && gisLevel !== 'district') gisRenderTamilNadu();
    setTimeout(() => {
      const layer = L.geoJSON(r.layerData);
      gisSelectDistrict(r.name, layer);
    }, gisLevel==='india' ? 300 : 0);
  }
}
document.addEventListener('click', (e) => {
  const wrap = document.getElementById('gis-search-wrap') || (document.getElementById('gis-search') && document.getElementById('gis-search').parentElement);
  if(wrap && !wrap.contains(e.target)) { const r=document.getElementById('gis-search-results'); if(r) r.style.display='none'; }
});

// ============ GIS: CONTROLS ============
function gisResetView(){
  if(!map) return;
  if(gisLevel === 'india') map.setView([22.9,80], 4.4);
  else if(gisLevel === 'tamilnadu' && gisDistrictsLayer) map.fitBounds(gisDistrictsLayer.getBounds(), {padding:[16,16]});
  else if(gisLevel === 'district') gisRenderTamilNadu();
}
function gisLocateMe(){
  if(!navigator.geolocation){ showToast('⚠️','Location not supported in this browser'); return; }
  showToast('📍','Requesting your location…');
  navigator.geolocation.getCurrentPosition(
    pos => {
