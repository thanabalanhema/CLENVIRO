// ============ PHASE 6: IoT + REAL-TIME SENSOR SIMULATION ============
// Architecture: SmartBin (physical) -> Sensors -> ESP32 -> MQTT/API -> here.
// No physical hardware is connected. MockIoTProvider stands in for a real
// MQTT broker/backend; iotService is the stable interface the rest of the
// app calls, so a real provider could later replace MockIoTProvider without
// touching any UI code.
const MockIoTProvider = {
  _connected: false, _tick: 0,
  connect(){ this._connected = true; return Promise.resolve({status:'connected', provider:'MockIoTProvider (simulation)'}); },
  disconnect(){ this._connected = false; },
  isConnected(){ return this._connected; },
  advanceTick(){ this._tick++; return this._tick; },
};
const iotService = {
  connect: () => MockIoTProvider.connect(),
  disconnect: () => MockIoTProvider.disconnect(),
  isConnected: () => MockIoTProvider.isConnected(),
  getBinState: (binId) => IOT_STATE[binId],
  getAllBinStates: () => IOT_STATE,
  publishSensorData(binId, payload){ Object.assign(IOT_STATE[binId], payload); }, // real deployment: MQTT publish bins/{id}/telemetry
  subscribeToBin(binId, cb){ IOT_SUBSCRIBERS.push({binId, cb}); },
  getAlerts: () => IOT_ALERTS,
};
const IOT_SUBSCRIBERS = [];
const IOT_STATE = {};
const IOT_HISTORY = {}; // binId -> array of {t, fill, weight, temp, battery} for mini charts
let IOT_ALERTS = [];
let iotSimRunning = false;
let iotSimTimer = null;
let iotSelectedBin = null;
let iotAlertFilter = 'all';
let iotSortKey = 'fill';

const IOT_SENSORS = [
  {key:'fillLevel', name:'Ultrasonic Sensor', measures:'Fill Level', unit:'%'},
  {key:'weight', name:'Load Cell (HX711)', measures:'Waste Weight', unit:'kg'},
  {key:'gasLevel', name:'Gas Sensor (SGP30)', measures:'Gas Condition', unit:'ppm'},
  {key:'moisture', name:'Moisture Sensor', measures:'Moisture Level', unit:'%'},
  {key:'temperature', name:'Temperature Sensor', measures:'Temperature', unit:'°C'},
  {key:'metalDetected', name:'Metal Sensor', measures:'Metal Detection', unit:''},
  {key:'batteryLevel', name:'Battery Sensor', measures:'Battery Level', unit:'%'},
  {key:'signalStrength', name:'GPS/Radio Module', measures:'Location + Signal', unit:''},
];

function iotInitState(){
  BINS.forEach(bin => {
    const rand = gisSeed(bin.id + '|iot-init');
    IOT_STATE[bin.id] = {
      binId: bin.id, location: bin.loc, wasteType: bin.type,
      latitude: (BIN_COORDS[bin.loc]||[11.0168,76.9558])[0],
      longitude: (BIN_COORDS[bin.loc]||[11.0168,76.9558])[1],
      fillLevel: bin.fill,
      weight: +(bin.fill * 0.55 + rand()*4).toFixed(1),
      temperature: +(28 + rand()*6).toFixed(1),
      humidity: Math.round(55 + rand()*25),
      gasLevel: Math.round(200 + rand()*150),
      moisture: Math.round(20 + rand()*40),
      metalDetected: rand() > 0.85,
      batteryLevel: Math.round(60 + rand()*38),
      signalStrength: rand()>0.9 ? 'Weak' : 'Strong',
      online: rand() > 0.06,
      lastUpdated: new Date('2026-08-20T06:15:00Z').toISOString(),
      collectionRequired: bin.fill > 90,
      ticksSinceCollection: Math.round(rand()*40),
    };
    IOT_HISTORY[bin.id] = [{t:0, fill:IOT_STATE[bin.id].fillLevel, weight:IOT_STATE[bin.id].weight, temp:IOT_STATE[bin.id].temperature, battery:IOT_STATE[bin.id].batteryLevel}];
  });
}

// One deterministic simulation step. Same tick number -> same deltas.
function iotStep(){
  const tick = MockIoTProvider.advanceTick();
  BINS.forEach(bin => {
    const s = IOT_STATE[bin.id];
    if(!s) return;
    const rand = gisSeed(bin.id + '|tick|' + tick);
    if(!s.online){
      // offline bins occasionally reconnect
      if(rand() > 0.7) s.online = true;
      return;
    }
    if(rand() > 0.985){ s.online = false; s.signalStrength = 'Offline'; return; } // rare deterministic dropout

    s.fillLevel = Math.min(100, +(s.fillLevel + rand()*1.4).toFixed(1));
    s.weight = +(s.fillLevel * 0.55 + rand()*3).toFixed(1);
    s.temperature = +(Math.max(24, Math.min(38, s.temperature + (rand()-0.5)*0.8))).toFixed(1);
    s.humidity = Math.max(30, Math.min(95, Math.round(s.humidity + (rand()-0.5)*4)));
    s.gasLevel = Math.max(150, Math.min(600, Math.round(s.gasLevel + (rand()-0.45)*20)));
    s.moisture = Math.max(10, Math.min(90, Math.round(s.moisture + (rand()-0.5)*3)));
    s.metalDetected = rand() > 0.9;
    s.batteryLevel = Math.max(2, +(s.batteryLevel - rand()*0.25).toFixed(1));
    s.signalStrength = s.batteryLevel < 15 ? 'Weak' : (rand()>0.92 ? 'Weak' : 'Strong');
    s.collectionRequired = s.fillLevel > 90;
    s.ticksSinceCollection++;
    s.lastUpdated = new Date(new Date('2026-08-20T06:15:00Z').getTime() + tick*15000).toISOString();

    const h = IOT_HISTORY[bin.id];
    h.push({t:tick, fill:s.fillLevel, weight:s.weight, temp:s.temperature, battery:s.batteryLevel});
    if(h.length > 150) h.shift(); // retention cap — see CLENVIRO_DATA_VERSION notes
  });
  iotEvaluateAlerts();
  iotSyncBinsArray();
  if(typeof LocalDataProvider !== 'undefined') LocalDataProvider._persist();
}

// Keep the existing BINS[].fill/status in sync so GIS markers, Overview KPIs
// and the Citizen portal (which all read BINS) reflect live IoT state too.
function iotSyncBinsArray(){
  BINS.forEach(bin => {
    const s = IOT_STATE[bin.id];
    if(!s) return;
    bin.fill = Math.round(s.fillLevel);
    bin.status = s.fillLevel > 90 ? 'critical' : s.fillLevel >= 70 ? 'warning' : 'normal';
  });
}

// ---------- ALERT ENGINE ----------
const IOT_ACKNOWLEDGED = new Set(); // 'binId|type' combos the admin has cleared this session
function iotEvaluateAlerts(){
  const fresh = [];
  let seq = 1;
  const push = (bin, s, type, severity, category) => {
    if(IOT_ACKNOWLEDGED.has(bin.id+'|'+type)) return;
    fresh.push({id:'ALT-'+(seq++), binId:bin.id, location:bin.loc, type, severity, category, time:s.lastUpdated, status:'ACTIVE'});
  };
  BINS.forEach(bin => {
    const s = IOT_STATE[bin.id];
    if(!s) return;
    if(!s.online){ push(bin, s, 'Sensor Offline', 'critical', 'communication'); return; }
    if(s.fillLevel > 95) push(bin, s, 'Critical Overflow Risk', 'critical', 'critical');
    else if(s.fillLevel > 85) push(bin, s, 'Filling Soon', 'warning', 'critical');
    if(s.batteryLevel < 20) push(bin, s, 'Low Battery', s.batteryLevel<10?'critical':'warning', 'battery');
    if(s.gasLevel > 500) push(bin, s, 'Gas Alert', 'warning', 'sensor');
    if(s.temperature > 36) push(bin, s, 'Temperature Alert', 'warning', 'sensor');
    if(s.signalStrength === 'Weak') push(bin, s, 'Weak Signal', 'warning', 'communication');
  });
  // Mutate in place (don't reassign) so any external reference to this
  // array — e.g. the Phase 7 data service — stays valid.
  IOT_ALERTS.length = 0;
  fresh.forEach(a => IOT_ALERTS.push(a));
}
function iotAcknowledgeAlert(alertId){
  const a = IOT_ALERTS.find(x=>x.id===alertId);
  if(!a) return;
  IOT_ACKNOWLEDGED.add(a.binId+'|'+a.type);
  if(typeof clenviroDataService !== 'undefined') clenviroDataService.acknowledgeAlert(alertId);
  a.status = 'ACKNOWLEDGED';
  iotEvaluateAlerts();
  iotRenderAlertCenter();
  showToast('✅', a.id+' acknowledged');
}

// ---------- HEALTH SCORE ----------
function iotHealthScore(s){
  const battery = s.batteryLevel;
  const comm = s.online ? (s.signalStrength==='Strong'?100:65) : 0;
  const fillPenalty = s.fillLevel>95 ? 40 : s.fillLevel>85 ? 15 : 0;
  const score = Math.max(0, Math.round(battery*0.35 + comm*0.4 + (100-fillPenalty)*0.25));
  const label = score>=85?'Excellent':score>=65?'Good':score>=40?'Needs Attention':'Critical';
  return {score, label};
}
function iotOverflowEstimate(bin){
  const s = IOT_STATE[bin.id];
  const h = IOT_HISTORY[bin.id];
  if(!s || !h || h.length<2) return {ratePerTick:0, hoursToFull:null};
  const recent = h.slice(-6);
  const rate = (recent[recent.length-1].fill - recent[0].fill) / Math.max(1, recent.length-1); // %/tick
  if(rate <= 0.01) return {ratePerTick:rate, hoursToFull:null};
  const remaining = Math.max(0, 95 - s.fillLevel);
  const ticksToFull = remaining / rate;
  const hoursToFull = (ticksToFull * 15) / 3600; // 15s/tick simulated
  return {ratePerTick:rate, hoursToFull};
}

