D.version="11.5";
D.key="clenviro_editable_geo_data_v11_5";

/* State-level source dataset. Districts can be imported/created/edited without changing the UI. */
D.states=[
["Andhra Pradesh",6890,6890,1558],["Andaman and Nicobar Islands",79,78,74],["Arunachal Pradesh",228,199,9],
["Assam",1589,1333,575],["Bihar",4975,null,null],["Chandigarh",540,540,83],["Chhattisgarh",1820,1820,1790],
["Dadra and Nagar Haveli and Daman and Diu",267,267,246],["Delhi",11108,11108,5280],["Goa",211,207,197],
["Gujarat",10095,10095,8682],["Haryana",8766,6691,4297],["Himachal Pradesh",383,349,269],
["Jammu and Kashmir",1550,1540,606],["Jharkhand",2404,1969,843],["Karnataka",13034,11655,5440],
["Kerala",3472,1283,2691],["Ladakh",52,42,20],["Lakshadweep",18,18,18],["Madhya Pradesh",7115,6132,6059],
["Maharashtra",23531,23044,19980],["Manipur",282,199,133],["Meghalaya",165,137,27],["Mizoram",374,313,234],
["Nagaland",664,306,116],["Odisha",2103,2020,1356],["Puducherry",383,383,58],["Punjab",4222,4207,1471],
["Rajasthan",7973,7859,1926],["Sikkim",66,66,18],["Tamil Nadu",14586,14471,7206],["Telangana",11057,11057,8611],
["Tripura",333,322,220],["Uttar Pradesh",14710,14710,7321],["Uttarakhand",1585,1452,1050],["West Bengal",13709,13687,3047]
].map((x,i)=>({id:"ST-"+String(i+1).padStart(3,"0"),state:x[0],generated:x[1],collected:x[2],processed:x[3],landfilled:null,source:"CPCB SWM 2021-22"}));

D.districts=[];

D.load=function(){
 try{
  const raw=localStorage.getItem(D.key);
  if(raw){const x=JSON.parse(raw);if(x&&Array.isArray(x.states)&&Array.isArray(x.districts)){D.states=x.states;D.districts=x.districts;return}}
 }catch(e){}
};
D.save=function(){try{localStorage.setItem(D.key,JSON.stringify({version:D.version,states:D.states,districts:D.districts,updatedAt:new Date().toISOString()}))}catch(e){}};
D.esc=function(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))};
