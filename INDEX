// ---------- DRIVER TASKS ----------
let DRIVER_TASKS = [];
let driverTaskSeq = 23;
function iotCreateTaskFromAlert(binId){
  if(DRIVER_TASKS.some(t=>t.binId===binId && t.status!=='Collected')){ showToast('ℹ️','A task for this bin is already active.'); return; }
  const bin = BINS.find(b=>b.id===binId); const s = IOT_STATE[binId];
  driverTaskSeq++;
  DRIVER_TASKS.unshift({
    id: 'TASK-CLV-' + String(driverTaskSeq).padStart(4,'0'),
    binId, location: bin.loc, priority: s.fillLevel>95?'CRITICAL':s.fillLevel>85?'HIGH':'MEDIUM',
    wasteType: bin.type, estWeight: s.weight, reason: s.fillLevel>90?'Overflow Risk':'Collection Required',
    status: 'Pending'
  });
  iotRenderDriverTasks();
  showToast('🚛', `Task ${DRIVER_TASKS[0].id} created for ${bin.loc}`);
}
function iotAutoCreateTasks(){
  BINS.forEach(bin => { const s = IOT_STATE[bin.id]; if(s && (s.fillLevel>95 || s.collectionRequired) && !DRIVER_TASKS.some(t=>t.binId===bin.id && t.status!=='Collected')) iotCreateTaskFromAlert(bin.id); });
}
function iotAdvanceTask(taskId, newStatus){
  const task = DRIVER_TASKS.find(t=>t.id===taskId);
  if(!task) return;
  task.status = newStatus;
  if(newStatus === 'Collected'){
    const s = IOT_STATE[task.binId];
    if(s){ s.fillLevel = 0; s.weight = 0; s.collectionRequired = false; s.ticksSinceCollection = 0; }
    iotSyncBinsArray();
    showToast('✅', `${task.binId} marked collected — fill reset to 0%`);
    iotRenderAll();
  }
  iotRenderDriverTasks();
}
function iotRenderDriverTasks(){
  const el = document.getElementById('driver-iot-tasks');
  if(!el) return;
  if(!DRIVER_TASKS.length){ el.innerHTML = '<div style="font-size:12px;color:var(--text2);padding:8px 0;">No IoT-generated collection tasks right now.</div>'; return; }
  el.innerHTML = DRIVER_TASKS.map(t => `
    <div style="padding:10px;background:var(--bg3);border-radius:8px;margin-bottom:8px;">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div><div style="font-size:12px;font-weight:700;">${t.id} — ${t.binId} (${t.location})</div>
        <div style="font-size:11px;color:var(--text2);">Priority: ${t.priority} · ${t.reason} · Est. ${t.estWeight}kg</div></div>
        <span class="status-chip ${t.status==='Collected'?'sc-green':t.status==='In Progress'?'sc-yellow':'sc-blue'}">${t.status}</span>
      </div>
      ${t.status!=='Collected' ? `<div style="display:flex;gap:6px;margin-top:8px;">
        ${t.status==='Pending'?`<button class="btn-sm btn-approve" onclick="iotAdvanceTask('${t.id}','Accepted')">ACCEPT TASK</button>`:''}
        ${t.status==='Accepted'?`<button class="btn-sm btn-approve" onclick="iotAdvanceTask('${t.id}','In Progress')">START COLLECTION</button>`:''}
        ${t.status==='In Progress'?`<button class="btn-sm btn-approve" onclick="iotAdvanceTask('${t.id}','Collected')">MARK COLLECTED</button>`:''}
      </div>` : ''}
    </div>`).join('');
}

// ============ PHASE 7: DATA SERVICE + PERSISTENCE ARCHITECTURE ============
// HONESTY NOTE (read this before assuming this survives a page refresh):
// This build runs inside Claude's in-chat artifact preview, which sandboxes
// the iframe and does not reliably expose window.localStorage. Per that
// constraint, LocalDataProvider below is an IN-MEMORY namespaced store —
// it gives every portal ONE shared data model during this session (exactly
// like localStorage would), but a real browser refresh still resets it.
// If you download this file and open it directly in your own browser
// (outside the Claude preview), real localStorage works fine there — see
// "swap-in real localStorage" in LocalDataProvider._persist() below for the
// ~4-line change that enables it.
const CLENVIRO_DATA_VERSION = 1;
const CLENVIRO_STORAGE_NAMESPACES = ['clenviro_bins','clenviro_reports','clenviro_alerts','clenviro_tasks','clenviro_sensor_history','clenviro_settings'];

const LocalDataProvider = {
  _store: {},
  _writes: 0,

  init(){
    if(this._store._initialized) return;
    this._store = {
      _initialized: true,
      clenviro_bins: {},          // binId -> SmartBin state
      clenviro_reports: [],       // citizen reports
      clenviro_alerts: [],        // IoT alerts
      clenviro_tasks: [],         // driver collection tasks
      clenviro_sensor_history: {},// binId -> [{t, fill, weight, temp, battery}]
      clenviro_settings: { dataVersion: CLENVIRO_DATA_VERSION, storageMode: 'LOCAL PROTOTYPE STORAGE (in-memory, this session)' },
    };
  },
  _persist(){
    // Swap-in point for real localStorage in your own browser (outside the
    // Claude.ai preview sandbox), where it works fine:
    //   CLENVIRO_STORAGE_NAMESPACES.forEach(k => localStorage.setItem(k, JSON.stringify(this._store[k])));
    // Left as a no-op in-memory write here — see the note at the top of this file.
    this._writes++;
  },
  get(ns){ return this._store[ns]; },
  set(ns, value){ this._store[ns] = value; this._persist(); },
};

// ---------- VALIDATION (runs before every persisted write) ----------
function dsValidateBin(bin){
  const errors = [];
  if(!bin.binId) errors.push('binId is required');
  if(bin.fillLevel!=null && (bin.fillLevel<0 || bin.fillLevel>100)) errors.push('fillLevel out of range 0-100');
  if(bin.batteryLevel!=null && (bin.batteryLevel<0 || bin.batteryLevel>100)) errors.push('batteryLevel out of range 0-100');
  if(bin.weight!=null && bin.weight<0) errors.push('weight cannot be negative');
  if(bin.temperature!=null && typeof bin.temperature!=='number') errors.push('temperature must be numeric');
  return errors;
}

// ---------- PUBLIC DATA SERVICE ----------
// UI code should go through this rather than touching storage directly.
// Internally it wraps the SAME live objects (IOT_STATE, CITIZEN_REPORTS,
// DRIVER_TASKS, IOT_ALERTS, IOT_HISTORY) that the rest of the app already
// mutates in place — so nothing had to be rewired at risk of breaking
// Phases 1-6; this adds a documented, validated access layer on top.
const clenviroDataService = {
  initialize(){
    LocalDataProvider.init();
    const existing = LocalDataProvider.get('clenviro_bins');
    if(existing && Object.keys(existing).length){
      // "IF persistent data exists: load it" — in this in-memory provider
      // that only means "don't re-run first-time setup twice".
      return;
    }
    LocalDataProvider.set('clenviro_bins', IOT_STATE);
    LocalDataProvider.set('clenviro_reports', CITIZEN_REPORTS);
    LocalDataProvider.set('clenviro_alerts', IOT_ALERTS);
    LocalDataProvider.set('clenviro_tasks', DRIVER_TASKS);
    LocalDataProvider.set('clenviro_sensor_history', IOT_HISTORY);
  },

  getBins(){ return IOT_STATE; },
  getBin(binId){ return IOT_STATE[binId]; },
  saveBin(bin){
    const errors = dsValidateBin(bin);
    if(errors.length){ console.warn('clenviroDataService.saveBin rejected:', errors); return {ok:false, errors}; }
    IOT_STATE[bin.binId] = {...IOT_STATE[bin.binId], ...bin};
    LocalDataProvider._persist();
    return {ok:true};
  },
  updateBin(binId, changes){ return this.saveBin({binId, ...changes}); },

  getReports(){ return CITIZEN_REPORTS; },
  saveReport(report){ CITIZEN_REPORTS.unshift(report); LocalDataProvider._persist(); },

  getAlerts(){ return IOT_ALERTS; },
  saveAlert(alert){ IOT_ALERTS.push(alert); LocalDataProvider._persist(); },
  acknowledgeAlert(alertId){
    const a = IOT_ALERTS.find(x=>x.id===alertId);
    if(a){ a.status = 'ACKNOWLEDGED'; a.acknowledgedAt = new Date().toISOString(); LocalDataProvider._persist(); }
  },

  getTasks(){ return DRIVER_TASKS; },
  saveTask(task){ DRIVER_TASKS.unshift(task); LocalDataProvider._persist(); },
  updateTask(taskId, changes){
    const t = DRIVER_TASKS.find(x=>x.id===taskId);
    if(t){ Object.assign(t, changes); LocalDataProvider._persist(); }
  },

  getSensorHistory(binId){ return IOT_HISTORY[binId] || []; },
  saveSensorReading(reading){
    if(!IOT_HISTORY[reading.binId]) IOT_HISTORY[reading.binId] = [];
    IOT_HISTORY[reading.binId].push(reading);
    if(IOT_HISTORY[reading.binId].length > 150) IOT_HISTORY[reading.binId].shift();
    LocalDataProvider._persist();
  },

  getStorageStatus(){
    return {
      mode: LocalDataProvider._store.clenviro_settings?.storageMode || 'LOCAL PROTOTYPE STORAGE',
      dataVersion: CLENVIRO_DATA_VERSION,
      binsStored: Object.keys(IOT_STATE).length,
      sensorReadingsStored: Object.values(IOT_HISTORY).reduce((s,h)=>s+h.length,0),
      activeAlerts: IOT_ALERTS.filter(a=>a.status==='ACTIVE').length,
      openTasks: DRIVER_TASKS.filter(t=>t.status!=='Collected').length,
      reportsStored: CITIZEN_REPORTS.length,
      writeCount: LocalDataProvider._writes,
    };
  },

  clearDemoData(){
    Object.keys(IOT_STATE).forEach(k=>delete IOT_STATE[k]);
    Object.keys(IOT_HISTORY).forEach(k=>delete IOT_HISTORY[k]);
    IOT_ALERTS.length = 0;
    DRIVER_TASKS.length = 0;
    CITIZEN_REPORTS.length = 0;
    citReportSeq = 123; driverTaskSeq = 23;
    if(typeof iotInitState === 'function') iotInitState();
    LocalDataProvider._persist();
  },
};

// ---------- FUTURE-READY ABSTRACTIONS ----------
//   UI -> clenviroDataService -> LocalDataProvider -> in-memory (current, always used for the app's own interactive state)
//   UI -> clenviroDataService -> ApiDataProvider    -> real backend -> DB  (implemented below, real fetch() calls)
//
// HONESTY NOTE: ApiDataProvider genuinely calls a real backend when one is
// configured and reachable (see clenviro-backend/, delivered alongside this
// file — a real Express + SQLite + MQTT service, not a mock). What it does
// NOT do: replace LocalDataProvider as the app's live data source. Rewiring
// every existing synchronous read (IOT_STATE[id], BINS.find(...), etc.)
// across Phases 4-8 to an async fetch-based path would touch most of this
// file for no functional gain in a single-file demo, so this stays as a
// working, testable INTEGRATION POINT — proven reachable via a real health
// check — rather than the app's primary data path. See DEPLOYMENT.md in the
// backend project for how to point this at a running instance.
const CLENVIRO_API_BASE_URL = new URLSearchParams(window.location.search).get('apiBase') || null;
let clenviroBackendMode = CLENVIRO_API_BASE_URL ? 'CHECKING' : 'DEMO';

const ApiDataProvider = {
  // PHASE 11.3: the backend now uses an HttpOnly session cookie instead of
  // a Bearer JWT — there is no longer a token for this object to hold at
  // all (that's the point: page JS has no access to the credential that
  // grants access). `credentials:'include'` tells fetch() to send/receive
  // that cookie; every authenticated call below needs it, reads too,
  // since a couple of read routes are now session-gated on the backend
  // and this file should not silently assume otherwise.
  _jsonHeaders(){ return {'Content-Type':'application/json'}; },
  async health(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/health', {signal: AbortSignal.timeout(2500)}); if(!r.ok) throw new Error('health check failed'); return r.json(); },
  async login(username, password){
    const r = await fetch(CLENVIRO_API_BASE_URL + '/auth/login', {method:'POST', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify({username,password})});
    if(!r.ok) throw new Error('login failed');
    return r.json(); // {user} — no token; the session cookie is set by the browser automatically
  },
  async logout(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/auth/logout', {method:'POST', credentials:'include'}); return r.status === 204; },
  async me(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/auth/me', {credentials:'include'}); if(!r.ok) return null; return r.json(); },
  // Bins
  async getBins(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins', {credentials:'include'}); if(!r.ok) throw new Error('GET /bins failed'); return r.json(); },
  async getBin(id){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins/' + encodeURIComponent(id), {credentials:'include'}); if(!r.ok) throw new Error('GET /bins/:id failed'); return r.json(); },
  async saveBin(bin){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins', {method:'POST', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(bin)}); if(!r.ok) throw new Error('POST /bins failed: '+(await r.text())); return r.json(); },
  async updateBin(id, changes){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins/' + encodeURIComponent(id), {method:'PUT', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(changes)}); if(!r.ok) throw new Error('PUT /bins/:id failed'); return r.json(); },
  // Sensor history / telemetry ingestion — maps to the SAME endpoint the
  // MQTT listener feeds on the backend, per MQTT.md/API.md.
  async getSensorHistory(binId, limit){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins/' + encodeURIComponent(binId) + '/history' + (limit?('?limit='+limit):''), {credentials:'include'}); if(!r.ok) throw new Error('GET history failed'); return r.json(); },
  async saveSensorReading(reading){ const r = await fetch(CLENVIRO_API_BASE_URL + '/bins/telemetry', {method:'POST', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(reading)}); if(!r.ok) throw new Error('POST telemetry failed: '+(await r.text())); return r.json(); },
  // Alerts
  async getAlerts(status){ const r = await fetch(CLENVIRO_API_BASE_URL + '/alerts' + (status?('?status='+status):''), {credentials:'include'}); if(!r.ok) throw new Error('GET /alerts failed'); return r.json(); },
  async saveAlert(alert){ const r = await fetch(CLENVIRO_API_BASE_URL + '/alerts', {method:'POST', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(alert)}); if(!r.ok) throw new Error('POST /alerts failed'); return r.json(); },
  async acknowledgeAlert(id){ const r = await fetch(CLENVIRO_API_BASE_URL + '/alerts/' + encodeURIComponent(id) + '/acknowledge', {method:'PUT', credentials:'include'}); if(!r.ok) throw new Error('acknowledge failed'); return r.json(); },
  // Reports (deliberately unauthenticated on the backend — citizens submit
  // without a login in this prototype, matching the existing route)
  async getReports(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/reports', {credentials:'include'}); if(!r.ok) throw new Error('GET /reports failed'); return r.json(); },
  async saveReport(report){ const r = await fetch(CLENVIRO_API_BASE_URL + '/reports', {method:'POST', headers:this._jsonHeaders(), body:JSON.stringify(report)}); if(!r.ok) throw new Error('POST /reports failed'); return r.json(); },
  // Tasks
  async getTasks(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/tasks', {credentials:'include'}); if(!r.ok) throw new Error('GET /tasks failed'); return r.json(); },
  async saveTask(task){ const r = await fetch(CLENVIRO_API_BASE_URL + '/tasks', {method:'POST', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(task)}); if(!r.ok) throw new Error('POST /tasks failed'); return r.json(); },
  async updateTask(id, status){ const r = await fetch(CLENVIRO_API_BASE_URL + '/tasks/' + encodeURIComponent(id), {method:'PUT', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify({status})}); if(!r.ok) throw new Error('PUT /tasks/:id failed: '+(await r.text())); return r.json(); },
  // Trucks
  async getTrucks(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/trucks', {credentials:'include'}); if(!r.ok) throw new Error('GET /trucks failed'); return r.json(); },
  async getTruck(id){ const r = await fetch(CLENVIRO_API_BASE_URL + '/trucks/' + encodeURIComponent(id), {credentials:'include'}); if(!r.ok) throw new Error('GET /trucks/:id failed'); return r.json(); },
  async updateTruck(id, changes){ const r = await fetch(CLENVIRO_API_BASE_URL + '/trucks/' + encodeURIComponent(id), {method:'PUT', headers:this._jsonHeaders(), credentials:'include', body:JSON.stringify(changes)}); if(!r.ok) throw new Error('PUT /trucks/:id failed'); return r.json(); },
  // System / analytics — NOTE: there is no dedicated /api/routes resource on
  // the backend (routes are computed client-side by the Phase 8 AI engine,
  // not persisted server-side yet) — no getRoutes/saveRoute method exists
  // here because calling one would either silently 404 or have to be faked,
  // and this file doesn't do either.
  async getSystemStatus(){ const r = await fetch(CLENVIRO_API_BASE_URL + '/analytics/summary', {credentials:'include'}); if(!r.ok) throw new Error('GET /analytics/summary failed'); return r.json(); },
  async getAnalyticsSummary(){ return this.getSystemStatus(); },
};

async function dsCheckBackendMode(){
  if(!CLENVIRO_API_BASE_URL){ clenviroBackendMode = 'DEMO'; dsRenderStatusPanel(); return; }
  try{
    const h = await ApiDataProvider.health();
    clenviroBackendMode = (h.api === 'up' && h.database === 'up') ? 'LIVE' : 'DEMO';
  }catch(e){
    clenviroBackendMode = 'DEMO (backend unreachable)';
