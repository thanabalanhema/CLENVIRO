};
D.parseCSV=function(text){
 const lines=text.replace(/\r/g,"").split("\n").filter(Boolean);
 if(!lines.length)return [];
 const parseLine=line=>{let out=[],cur="",q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'&&line[i+1]==='"'){cur+='"';i++;continue}if(ch==='"'){q=!q;continue}if(ch===","&&!q){out.push(cur);cur="";continue}cur+=ch}out.push(cur);return out};
 const heads=parseLine(lines[0]).map(x=>x.trim().toLowerCase());
 return lines.slice(1).map(line=>{const a=parseLine(line),o={};heads.forEach((h,i)=>o[h]=a[i]??"");return o});
};
D.importFile=function(file){
 const reader=new FileReader();
 reader.onload=function(){
  try{
   const text=String(reader.result||"");
   if(file.name.toLowerCase().endsWith(".json")){
    const x=JSON.parse(text);
    if(Array.isArray(x.states))D.states=x.states;
    if(Array.isArray(x.districts))D.districts=x.districts;
   }else{
    const rows=D.parseCSV(text);
    const isDistrict=rows.some(r=>r.district!==undefined&&r.district!=="");
    if(isDistrict){
     D.districts=rows.map((r,i)=>({id:r.id||"DT-"+Date.now()+"-"+i,state:r.state||"",district:r.district||"",generated:D.num(r.generated),collected:D.num(r.collected),processed:D.num(r.processed),landfilled:D.num(r.landfilled),source:r.source||"Imported"}));
     rows.forEach(r=>D.ensureState(r.state||"Unknown"));
    }else{
     D.states=rows.map((r,i)=>({id:r.id||"ST-"+Date.now()+"-"+i,state:r.state||"",generated:D.num(r.generated),collected:D.num(r.collected),processed:D.num(r.processed),landfilled:D.num(r.landfilled),source:r.source||"Imported"}));
    }
   }
