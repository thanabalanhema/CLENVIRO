 const p=document.getElementById('ppx-'+name);if(p)p.classList.add('active');
 document.querySelectorAll('#page-panchayat .ppx-tab').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');
};
window.ppxNotify=function(msg){
 if(typeof showToast==='function'){try{showToast('ℹ️',msg);return}catch(e){}}
 alert(msg);
