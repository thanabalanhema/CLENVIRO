let aiDriverRoute = { truckId:null, stops:[], currentIndex:0, started:false };
function aiPushDriverRoute(){
  if(!aiLastRoutePlan) return;
  const myTruck = aiLastRoutePlan.trucks.find(t=>t.truckId==='TRK-101') || aiLastRoutePlan.trucks[0];
  if(myTruck) aiDriverRoute = { truckId:myTruck.truckId, stops:[...myTruck.route], currentIndex:0, started:false, estDistanceKm:myTruck.estDistanceKm, estTimeMin:myTruck.estTimeMin, capacityUtilPct:myTruck.capacityUtilPct };
