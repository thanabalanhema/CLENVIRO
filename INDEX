    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px;">
      <div>
        <div class="gis-stat-label">CLENVIRO Smart Bins</div>
        <div class="gis-stat-val">${isCbe ? binCount : 'N/A'}</div>
        ${isCbe ? '<span class="source-badge" style="background:rgba(139,88,255,.14);color:#7c3aed;border:1px solid rgba(139,88,255,.35);">🟣 DEMO DATA</span>' : '<span class="source-meta">Not yet deployed</span>'}
      </div>
      <div>
        <div class="gis-stat-label">Critical Bins</div>
        <div class="gis-stat-val" style="color:${criticalCount>0?'var(--red)':'var(--text)'}">${isCbe ? criticalCount : 'N/A'}</div>
      </div>
      <div>
        <div class="gis-stat-label">Active Trucks</div>
        <div class="gis-stat-val">${isCbe ? truckCount : 'N/A'}</div>
        ${isCbe ? '<span class="source-badge" style="background:rgba(139,88,255,.14);color:#7c3aed;border:1px solid rgba(139,88,255,.35);">🟣 DEMO GPS</span>' : ''}
      </div>
      <div>
        <div class="gis-stat-label">Government Data</div>
        <div style="font-size:11px;color:var(--text2);margin-top:2px;line-height:1.5;">District-level government data not available in imported dataset.</div>
