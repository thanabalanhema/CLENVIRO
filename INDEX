<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="clenviro-panchayat-module" content="Mandatory Panchayat workforce and operations module">
<title>CLENVIRO AI – Smart Waste Command Center</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
:root {
  --bg: #FFFFFF;
  --bg2: #F8FAFC;
  --bg3: #F1F5F9;
  --card: #FFFFFF;
  --card2: #F8FAFC;
  --border: #E2E8F0;
  --teal: #00b894;
  --teal2: #009677;
  --cyan: #0891b2;
  --blue: #2563eb;
  --yellow: #d97706;
  --orange: #ea580c;
  --red: #dc2626;
  --green: #059669;
  --text: #0F172A;
  --text2: #475569;
  --text3: #64748B;
  --shadow: 0 4px 16px rgba(15,23,42,0.08);
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg2);color:var(--text);font-family:'Nunito',sans-serif;overflow-x:hidden;}
/* ===================== LOGIN ===================== */
#login-screen{
  position:fixed;inset:0;z-index:9999;
  background:linear-gradient(135deg,#F8FAFC 0%,#FFFFFF 50%,#F1F5F9 100%);
  display:flex;align-items:center;justify-content:center;
}
.login-bg{
  position:absolute;inset:0;overflow:hidden;pointer-events:none;
}
.login-bg::before{
  content:'';position:absolute;width:600px;height:600px;
  background:radial-gradient(circle,rgba(0,212,170,0.08) 0%,transparent 70%);
  top:10%;left:20%;animation:pulse-bg 4s ease-in-out infinite;
}
.login-bg::after{
  content:'';position:absolute;width:400px;height:400px;
  background:radial-gradient(circle,rgba(0,229,255,0.06) 0%,transparent 70%);
  bottom:15%;right:15%;animation:pulse-bg 4s ease-in-out infinite 2s;
}
@keyframes pulse-bg{0%,100%{opacity:0.5;transform:scale(1);}50%{opacity:1;transform:scale(1.1);}}
.login-box{
  width:440px;padding:48px 40px;
  background:#FFFFFF;
  border:1px solid var(--border);border-radius:20px;
  box-shadow:0 0 60px rgba(0,184,148,0.10),var(--shadow);
  position:relative;z-index:1;
  animation:slideUp 0.6s ease;
}
@keyframes slideUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}
.login-logo{text-align:center;margin-bottom:32px;}
.login-logo .logo-icon{
  width:100%;height:92px;margin:0 auto 12px;
  border-radius:14px;overflow:hidden;
  box-shadow:0 0 30px rgba(0,184,148,0.22);
}
.login-logo .logo-icon img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;}
.login-logo h1{font-family:'Rajdhani',sans-serif;font-size:28px;font-weight:700;
  background:linear-gradient(90deg,var(--teal),var(--cyan));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.login-logo p{color:var(--text2);font-size:12px;letter-spacing:2px;margin-top:4px;}
.role-tabs{display:flex;gap:8px;margin-bottom:24px;background:var(--bg3);border-radius:12px;padding:4px;}
.role-tab{flex:1;padding:10px 4px;border:none;background:transparent;color:var(--text2);
  font-family:'Nunito',sans-serif;font-size:13px;font-weight:600;border-radius:8px;
  cursor:pointer;transition:all 0.3s;}
.role-tab.active{background:linear-gradient(135deg,var(--teal),var(--teal2));color:#000;box-shadow:0 4px 15px rgba(0,212,170,0.3);}
.login-label{font-size:12px;color:var(--text2);letter-spacing:1px;margin-bottom:6px;display:block;}
.login-input{
  width:100%;padding:12px 16px;margin-bottom:16px;
  background:var(--bg3);border:1px solid var(--border);border-radius:10px;
  color:var(--text);font-size:14px;font-family:'Nunito',sans-serif;
  transition:border-color 0.3s,box-shadow 0.3s;outline:none;
}
.login-input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,212,170,0.1);}
.login-btn{
  width:100%;padding:14px;border:none;border-radius:10px;
  background:linear-gradient(135deg,var(--teal),var(--cyan));
  color:#000;font-weight:700;font-size:15px;font-family:'Rajdhani',sans-serif;
  letter-spacing:1px;cursor:pointer;transition:all 0.3s;
  box-shadow:0 4px 20px rgba(0,212,170,0.3);
}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,212,170,0.5);}
.login-hint{margin-top:20px;padding:12px 16px;background:rgba(0,212,170,0.05);
  border:1px solid rgba(0,212,170,0.1);border-radius:8px;}
.login-hint p{font-size:11px;color:var(--text3);line-height:1.6;font-family:'JetBrains Mono',monospace;}
.login-hint span{color:var(--teal);}
.login-error{color:var(--red);font-size:12px;text-align:center;margin-top:8px;display:none;}
/* ===================== APP SHELL ===================== */
#app{display:none;}
.brand-header{width:100%;background:#FFFFFF;border-bottom:1px solid var(--border);box-shadow:0 1px 3px rgba(15,23,42,0.05);}
.brand-header-img{display:block;width:100%;height:220px;object-fit:cover;object-position:center;}
.brand-header-caption{text-align:center;padding:7px 12px;font-size:11px;letter-spacing:3px;color:var(--text2);font-weight:700;background:var(--bg2);}
@media (max-width:1024px){.brand-header-img{height:170px;}}
@media (max-width:480px){.brand-header-img{height:130px;}.brand-header-caption{font-size:9px;letter-spacing:2px;padding:5px 8px;}}
#iot-kpi-grid{grid-template-columns:repeat(6,1fr);}
@media (max-width:900px){#iot-kpi-grid{grid-template-columns:repeat(3,1fr);}}
@media (max-width:640px){.kpi-grid{grid-template-columns:repeat(2,1fr);}.section-grid{grid-template-columns:1fr;}#iot-kpi-grid{grid-template-columns:repeat(2,1fr);}}
.brand-mini-logo{width:30px;height:30px;border-radius:8px;object-fit:cover;object-position:center;box-shadow:0 0 0 1px var(--border);}
.header{
  height:60px;background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;position:sticky;top:0;z-index:100;
}
.header-left{display:flex;align-items:center;gap:12px;}
.header-logo{font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:700;
  background:linear-gradient(90deg,var(--teal),var(--cyan));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.header-badge{font-size:10px;background:rgba(0,212,170,0.1);border:1px solid rgba(0,212,170,0.3);
  color:var(--teal);padding:2px 8px;border-radius:20px;letter-spacing:1px;}
.header-right{display:flex;align-items:center;gap:12px;}
.live-indicator{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--green);}
.live-dot{width:8px;height:8px;background:var(--green);border-radius:50%;
  box-shadow:0 0 10px var(--green);animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0.3;}}
.notif-btn{width:36px;height:36px;background:var(--bg3);border:1px solid var(--border);
  border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  position:relative;font-size:16px;}
.notif-badge{position:absolute;top:-4px;right:-4px;width:16px;height:16px;
  background:var(--red);border-radius:50%;font-size:9px;
  display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;}
.user-chip{display:flex;align-items:center;gap:8px;padding:6px 12px;
  background:var(--bg3);border:1px solid var(--border);border-radius:8px;font-size:12px;}
.user-avatar{width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  font-size:12px;}
.logout-btn{padding:6px 14px;background:transparent;border:1px solid var(--border);
  color:var(--text2);border-radius:8px;cursor:pointer;font-size:12px;transition:all 0.2s;}
.logout-btn:hover{border-color:var(--red);color:var(--red);}
/* ===================== SIDEBAR ===================== */
.app-body{display:flex;height:calc(100vh - 60px);}
.sidebar{
  width:220px;min-width:220px;background:var(--bg2);border-right:1px solid var(--border);
  padding:16px 12px;display:flex;flex-direction:column;gap:4px;overflow-y:auto;
}
.nav-section{font-size:10px;color:var(--text3);letter-spacing:2px;
  padding:12px 8px 4px;font-family:'JetBrains Mono',monospace;}
.nav-btn{
  display:flex;align-items:center;gap:10px;padding:10px 12px;border:none;
  background:transparent;color:var(--text2);cursor:pointer;border-radius:8px;
  font-family:'Nunito',sans-serif;font-size:13px;font-weight:600;
  transition:all 0.2s;width:100%;text-align:left;
}
.nav-btn:hover{background:var(--bg3);color:var(--text);}
.nav-btn.active{background:rgba(0,212,170,0.1);color:var(--teal);border:1px solid rgba(0,212,170,0.2);}
.nav-btn .nav-icon{font-size:16px;width:20px;text-align:center;}
.nav-count{margin-left:auto;background:var(--red);color:#fff;border-radius:10px;
  padding:1px 6px;font-size:10px;font-weight:700;}
.nav-count.warn{background:var(--yellow);color:#000;}
/* ===================== MAIN CONTENT ===================== */
.main-content{flex:1;overflow-y:auto;padding:20px;background:var(--bg2);}
.page{display:none;}
.page.active{display:block;animation:fadeIn 0.4s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.page-title{font-family:'Rajdhani',sans-serif;font-size:24px;font-weight:700;margin-bottom:4px;}
.page-sub{color:var(--text2);font-size:13px;margin-bottom:20px;}
/* ===================== KPI CARDS ===================== */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px;}
.kpi-card{
  background:var(--card);border:1px solid var(--border);border-radius:14px;
  padding:20px;position:relative;overflow:hidden;
}
.kpi-card::before{
  content:'';position:absolute;top:0;right:0;width:80px;height:80px;
  border-radius:0 14px 0 80px;opacity:0.08;
}
.kpi-card.teal::before{background:var(--teal);}
.kpi-card.blue::before{background:var(--blue);}
.kpi-card.yellow::before{background:var(--yellow);}
.kpi-card.red::before{background:var(--red);}
.kpi-icon{font-size:24px;margin-bottom:8px;}
.kpi-val{font-family:'Rajdhani',sans-serif;font-size:32px;font-weight:700;line-height:1;}
.kpi-label{font-size:12px;color:var(--text2);margin-top:4px;}
.kpi-trend{font-size:11px;margin-top:8px;display:flex;align-items:center;gap:4px;}
.trend-pos{color:var(--green);}
.trend-neg{color:var(--red);}
.fill-blue{background:linear-gradient(90deg,var(--blue),#2563eb);}
.source-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.3px;white-space:nowrap;}
.source-badge.govt{background:rgba(41,121,255,.14);color:#2563eb;border:1px solid rgba(41,121,255,.35);}
.source-meta{font-size:11px;color:var(--text2);}
/* ===================== SECTION GRID ===================== */
.section-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.section-grid.tri{grid-template-columns:1fr 1fr 1fr;}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.card-title{font-family:'Rajdhani',sans-serif;font-size:16px;font-weight:600;}
.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.badge.red{background:rgba(255,23,68,0.15);color:var(--red);}
.badge.yellow{background:rgba(255,214,0,0.15);color:var(--yellow);}
.badge.green{background:rgba(0,230,118,0.15);color:var(--green);}
.badge.teal{background:rgba(0,212,170,0.15);color:var(--teal);}
.badge.blue{background:rgba(41,121,255,0.15);color:#2563eb;}
/* ===================== BIN CARDS ===================== */
.bin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.bin-card{
  background:var(--card2);border-radius:12px;padding:14px;
  border-left:4px solid var(--green);transition:all 0.3s;cursor:pointer;
  border-top:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border);
}
.bin-card.critical{border-left-color:var(--red);animation:pulse-card 2s infinite;}
.bin-card.warning{border-left-color:var(--yellow);}
@keyframes pulse-card{0%,100%{box-shadow:0 0 0 0 rgba(255,23,68,0.3);}50%{box-shadow:0 0 0 8px rgba(255,23,68,0);}}
.bin-top{display:flex;justify-content:space-between;align-items:start;margin-bottom:8px;}
.bin-id{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3);}
.bin-loc{font-size:13px;font-weight:700;margin-top:2px;}
.bin-fill-bar{background:var(--bg3);border-radius:4px;height:6px;margin:8px 0;}
.bin-fill-inner{height:100%;border-radius:4px;transition:width 0.5s ease;}
.fill-green{background:linear-gradient(90deg,var(--teal),var(--green));}
.fill-yellow{background:linear-gradient(90deg,var(--yellow),var(--orange));}
.fill-red{background:linear-gradient(90deg,var(--orange),var(--red));}
.bin-stats{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
.bin-stat{font-size:10px;color:var(--text2);}
.bin-ai{margin-top:8px;padding:6px 8px;background:rgba(0,229,255,0.05);
  border:1px solid rgba(0,229,255,0.15);border-radius:6px;
  font-size:10px;color:var(--cyan);display:flex;align-items:center;gap:4px;}
.bin-actions{display:flex;gap:6px;margin-top:10px;}
.btn-xs{padding:4px 10px;border:none;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;font-family:'Nunito',sans-serif;}
.btn-red{background:rgba(255,23,68,0.15);color:var(--red);}
.btn-teal{background:rgba(0,212,170,0.15);color:var(--teal);}
/* ===================== REAL GIS MAP ===================== */
.gis-map-wrap{position:relative;}
#leaflet-map{
  background:#071224;border-radius:12px;height:420px;position:relative;
  border:1px solid var(--border);overflow:hidden;z-index:1;
}
.gis-toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:10px;}
.gis-breadcrumb{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:4px;flex-wrap:wrap;}
.crumb{cursor:pointer;padding:3px 8px;border-radius:6px;transition:all .2s;}
.crumb:hover{background:rgba(0,212,170,0.1);color:var(--teal);}
.crumb.active{color:var(--teal);font-weight:700;cursor:default;}
.crumb.active:hover{background:none;}
.crumb-sep{color:var(--border);}
.gis-search-wrap{position:relative;flex:1;min-width:160px;}
.gis-search{
  width:100%;padding:7px 12px;background:#FFFFFF;border:1px solid var(--border);
  color:var(--text);border-radius:20px;font-size:12px;font-family:'Nunito',sans-serif;
  box-shadow:0 1px 2px rgba(15,23,42,0.04);
}
.gis-search:focus{outline:none;border-color:var(--teal);}
.analytics-select{
  width:100%;padding:8px 12px;background:#FFFFFF;border:1px solid var(--border);
  color:var(--text);border-radius:10px;font-size:12px;font-family:'Nunito',sans-serif;
  cursor:pointer;
}
.analytics-select:disabled{color:var(--text2);cursor:not-allowed;background:var(--bg2);}
.analytics-select:focus{outline:none;border-color:var(--teal);}
.waste-guide-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;}
.waste-guide-card{background:var(--card2);border:1px solid var(--border);border-radius:10px;padding:12px 14px;}
.waste-guide-head{font-size:13px;font-weight:700;margin-bottom:8px;}
.waste-guide-row{font-size:11px;color:var(--text2);line-height:1.6;margin-bottom:4px;}
.wg-yes{color:var(--green);font-weight:700;}
.wg-no{color:var(--red);font-weight:700;}
.gis-search-results{
  position:absolute;top:36px;left:0;right:0;background:var(--card);border:1px solid var(--border);
  border-radius:10px;max-height:180px;overflow-y:auto;z-index:1000;display:none;
  box-shadow:0 8px 24px rgba(15,23,42,0.12);
}
.gis-search-item{padding:8px 12px;font-size:12px;cursor:pointer;border-bottom:1px solid var(--border);}
.gis-search-item:last-child{border-bottom:none;}
.gis-search-item:hover{background:rgba(0,212,170,0.08);color:var(--teal);}
.map-filter-btn{
  padding:5px 12px;background:#FFFFFF;border:1px solid var(--border);
  color:var(--text2);border-radius:20px;font-size:11px;cursor:pointer;
  font-family:'Nunito',sans-serif;transition:all 0.2s;
}
.map-filter-btn.active{background:rgba(0,212,170,0.1);border-color:var(--teal);color:var(--teal);}
.map-legend{
  position:absolute;bottom:12px;right:12px;
  background:rgba(6,13,26,0.9);border:1px solid var(--border);border-radius:8px;
  padding:8px 12px;display:flex;flex-direction:column;gap:4px;z-index:500;
}
.legend-item{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--text2);}
.legend-dot{width:8px;height:8px;border-radius:50%;}
.leaflet-truck-icon{font-size:18px;filter:drop-shadow(0 0 4px rgba(0,0,0,.8));text-align:center;}
#gis-info-panel{margin-top:14px;padding:16px;background:rgba(0,212,170,0.05);border:1px solid rgba(0,212,170,0.25);border-radius:12px;}
.gis-stat-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;}
.gis-stat-val{font-size:20px;font-weight:700;font-family:'Rajdhani',sans-serif;margin:2px 0 4px;}
/* Leaflet dark theme overrides */
.leaflet-container{background:#071224;font-family:'Nunito',sans-serif;}
.leaflet-popup-content-wrapper{background:var(--card);color:var(--text);border:1px solid var(--teal);border-radius:10px;}
.leaflet-popup-tip{background:var(--card);}
.leaflet-popup-content{font-size:12px;line-height:1.6;}
.leaflet-control-zoom a{background:rgba(6,13,26,0.9)!important;color:var(--text)!important;border-color:var(--border)!important;}
.leaflet-control-attribution{background:rgba(6,13,26,0.75)!important;color:var(--text2)!important;font-size:9px!important;}
.leaflet-control-attribution a{color:var(--teal)!important;}
.leaflet-tooltip{background:var(--card)!important;color:var(--text)!important;border-color:var(--teal)!important;font-size:11px!important;}
/* ===================== ANALYTICS BARS ===================== */
.chart-bar-wrap{display:flex;flex-direction:column;gap:8px;}
.chart-bar-row{display:flex;align-items:center;gap:10px;}
.chart-bar-label{font-size:11px;color:var(--text2);width:100px;text-align:right;white-space:nowrap;}
.chart-bar-track{flex:1;background:var(--bg3);border-radius:4px;height:8px;}
.chart-bar-fill{height:100%;border-radius:4px;transition:width 1s ease;}
.chart-bar-val{font-size:11px;color:var(--text);font-family:'JetBrains Mono',monospace;width:40px;}
/* ===================== AI ALERTS PANEL ===================== */
.alert-list{display:flex;flex-direction:column;gap:8px;}
.alert-item{
  padding:12px;border-radius:8px;border-left:3px solid;
  display:flex;align-items:flex-start;gap:10px;
}
.alert-item.crit{background:rgba(255,23,68,0.05);border-color:var(--red);}
.alert-item.warn{background:rgba(255,214,0,0.05);border-color:var(--yellow);}
.alert-item.info{background:rgba(0,229,255,0.05);border-color:var(--cyan);}
.alert-icon{font-size:16px;margin-top:1px;}
.alert-text{flex:1;}
.alert-title{font-size:12px;font-weight:700;margin-bottom:2px;}
.alert-desc{font-size:11px;color:var(--text2);line-height:1.4;}
.alert-time{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;margin-top:4px;}
.alert-action{padding:4px 10px;border:none;border-radius:6px;font-size:11px;font-weight:700;
  cursor:pointer;font-family:'Nunito',sans-serif;white-space:nowrap;align-self:start;margin-top:2px;}
.alert-action.red{background:rgba(255,23,68,0.15);color:var(--red);}
.alert-action.teal{background:rgba(0,212,170,0.15);color:var(--teal);}
/* ===================== APPROVAL QUEUE ===================== */
.approval-list{display:flex;flex-direction:column;gap:10px;}
.approval-item{
  background:var(--card2);border:1px solid var(--border);border-radius:10px;padding:14px;
  display:flex;align-items:center;gap:12px;
}
.ai-score-ring{
  width:48px;height:48px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:700;flex-shrink:0;
