function wasteMapColor(rate){
  if(rate == null) return '#64748b';
  if(rate >= 90) return '#059669';
  if(rate >= 70) return '#d97706';
  if(rate >= 50) return '#ea580c';
  return '#dc2626';
}
function stateWasteLookup(name){
  const n = String(name || '').toLowerCase().replace(/[&]/g,'and').replace(/\s+/g,' ').trim();
  const aliases = {
    'andaman and nicobar':'andaman and nicobar islands',
    'andaman & nicobar islands':'andaman and nicobar islands',
    'dadra and nagar haveli and daman and diu':'dadra and nagar haveli and daman and diu',
    'dadra and nagar haveli and daman diu':'dadra and nagar haveli and daman and diu',
    'jammu & kashmir':'jammu and kashmir',
    'jammu and kashmir':'jammu and kashmir'
  };
  const key = aliases[n] || n;
  return STATE_WASTE_MATRIX.find(r => r.state.toLowerCase() === key) || null;
}
function renderStateWasteMatrix(target){
  const prefix = target === 'overview' ? 'overview-' : '';
  const searchEl = document.getElementById(prefix+'matrix-search');
  const sortEl = document.getElementById(prefix+'matrix-sort');
  const body = document.getElementById(prefix+'state-matrix-body');
  const summary = document.getElementById(prefix+'matrix-summary');
  if(!body) return;
  let rows = [...STATE_WASTE_MATRIX];
  const q = (searchEl?.value || '').trim().toLowerCase();
  if(q) rows = rows.filter(r => r.state.toLowerCase().includes(q));
  const sort = sortEl?.value || 'collection';
  rows.sort((a,b)=>{
    if(sort==='state') return a.state.localeCompare(b.state);
    if(sort==='generated') return (b.generated||0)-(a.generated||0);
    if(sort==='collected') return (b.collected||0)-(a.collected||0);
    return (b.collectionPct ?? -1)-(a.collectionPct ?? -1);
  });
  const totalGenerated = STATE_WASTE_MATRIX.reduce((s,r)=>s+(r.generated||0),0);
  const totalCollected = STATE_WASTE_MATRIX.reduce((s,r)=>s+(r.collected||0),0);
  const knownCount = STATE_WASTE_MATRIX.filter(r=>r.collectionPct != null).length;
  const nationalRate = totalGenerated ? totalCollected/totalGenerated*100 : 0;
  if(summary){
    summary.innerHTML = `
      <div class="matrix-stat"><div class="matrix-stat-value">${STATE_WASTE_MATRIX.length}</div><div class="matrix-stat-label">States / UT records</div></div>
      <div class="matrix-stat"><div class="matrix-stat-value">${totalGenerated.toLocaleString()} TPD</div><div class="matrix-stat-label">Generated in source table</div></div>
      <div class="matrix-stat"><div class="matrix-stat-value">${totalCollected.toLocaleString()} TPD</div><div class="matrix-stat-label">Collected where reported</div></div>
      <div class="matrix-stat"><div class="matrix-stat-value">${nationalRate.toFixed(1)}%</div><div class="matrix-stat-label">Collection ratio of reported values</div></div>`;
  }
  body.innerHTML = rows.map(r => `
    <tr>
      <td><b>${r.state}</b></td>
      <td>${r.generated.toLocaleString()}</td>
      <td>${r.collected == null ? 'Data unavailable' : r.collected.toLocaleString()}</td>
      <td class="matrix-rate ${wasteRateClass(r.collectionPct)}">${wasteRateLabel(r.collectionPct)}</td>
      <td>${r.processed == null ? 'Data unavailable' : r.processed.toLocaleString()}</td>
      <td>${r.landfilled == null ? 'Data unavailable' : r.landfilled.toLocaleString()}</td>
      <td>${r.gap == null ? 'Data unavailable' : r.gap.toLocaleString()}</td>
      <td><span class="state-chip imported">IMPORTED</span></td>
    </tr>`).join('');
}
