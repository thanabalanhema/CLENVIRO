// ============ PHASE 8: AI PREDICTIVE OPERATIONS + ROUTE OPTIMIZATION ============
// Everything below is a deterministic, documented prototype heuristic —
// not a trained ML model, not connected to live traffic/GPS. Labelled
// "AI PROTOTYPE" / "SIMULATED INTELLIGENCE" throughout the UI.

// ---------- FLEET MODEL ----------
const TRUCKS = Object.keys(TRUCK_COORDS).map(id => ({
  truckId: id,
  driver: {'TRK-101':'Suresh K.','TRK-102':'Manoj R.','TRK-103':'Anitha V.','TRK-104':'Prakash S.','TRK-105':'Divya M.'}[id] || 'Unassigned',
  capacityKg: 2500,
  currentLoadKg: 0,
  status: 'AVAILABLE',
  latitude: TRUCK_COORDS[id][0], longitude: TRUCK_COORDS[id][1],
  fuelPct: 60 + Math.round(gisSeed(id+'|fuel')()*35),
  assignedBins: [],
  route: [],
  lastUpdated: new Date('2026-08-20T11:20:00Z').toISOString(),
}));

// ---------- PREDICTIVE OVERFLOW ENGINE ----------
function predictiveOverflowEngine(binId){
  const bin = BINS.find(b=>b.id===binId);
  const s = IOT_STATE[binId];
  if(!bin || !s) return null;
  if(!s.online){
    return {
      binId, currentFill: s.fillLevel, ratePerHour: 0,
      hoursTo85: null, hoursTo95: null, risk: 'UNKNOWN', offline: true,
      confidence: 'LOW', confidenceReason: 'Sensor is offline — last known reading may be stale.',
      source: 'OFFLINE', recommendation: 'Prediction unavailable while sensor is offline.',
    };
  }
  const h = (typeof IOT_HISTORY !== 'undefined' && IOT_HISTORY[binId]) || [];
  const enoughHistory = h.length >= 4;

  let ratePerHour, confidence, confidenceReason, source;
  if(enoughHistory){
    const recent = h.slice(-6);
    const ratePerTick = (recent[recent.length-1].fill - recent[0].fill) / Math.max(1, recent.length-1);
    ratePerHour = ratePerTick * (3600/15); // simulated tick = 15s
    confidence = h.length >= 10 ? 'HIGH' : 'MEDIUM';
    confidenceReason = h.length >= 10 ? 'Based on a substantial simulated sensor history for this bin.' : 'Limited historical IoT readings available — start the IoT simulation for more data.';
    source = 'PROTOTYPE IoT HISTORY';
  } else {
    // Fall back to the deterministic assumption model's baseline efficiency
    // as a stand-in fill-rate signal when there isn't enough sensor history yet.
    const baseline = generateLocationBaseline('Coimbatore', TN_DISTRICT_POPULATION['Coimbatore']);
    ratePerHour = (100 - baseline.baseEfficiency) * 0.06 + 0.4;
    confidence = 'LOW';
    confidenceReason = 'Insufficient IoT sensor history — using prototype assumption model as a fallback signal.';
    source = 'ASSUMPTION MODEL (fallback)';
  }
  ratePerHour = Math.max(0.05, ratePerHour);

  const hoursTo = (target) => s.fillLevel >= target ? 0 : +((target - s.fillLevel) / ratePerHour).toFixed(1);
  const hoursTo85 = hoursTo(85), hoursTo95 = hoursTo(95);
  const risk = s.fillLevel>=95 ? 'CRITICAL' : hoursTo95<=3 ? 'HIGH' : hoursTo95<=8 ? 'MEDIUM' : 'LOW';
  const windowHrs = risk==='CRITICAL' ? 0 : risk==='HIGH' ? 4 : risk==='MEDIUM' ? 12 : 24;

  return {
    binId, currentFill: s.fillLevel, ratePerHour: +ratePerHour.toFixed(2),
    hoursTo85, hoursTo95, risk, confidence, confidenceReason, source,
    recommendation: windowHrs===0 ? 'Collect immediately.' : `Collect within the next ${windowHrs}h.`,
  };
}

// ---------- PRIORITY SCORING ENGINE ----------
function collectionPriorityEngine(binId){
  const bin = BINS.find(b=>b.id===binId);
  const s = IOT_STATE[binId];
  const overflow = predictiveOverflowEngine(binId);
  if(!bin || !s || !overflow) return null;
  const riskScore = {CRITICAL:100, HIGH:75, MEDIUM:45, LOW:15, UNKNOWN:30}[overflow.risk] ?? 30;
  const fillScore = s.fillLevel;
  const weightScore = Math.min(100, s.weight * 1.3);
  const timeScore = Math.min(100, s.ticksSinceCollection * 2);
  const alertScore = IOT_ALERTS.some(a=>a.binId===binId && a.severity==='critical') ? 100 : IOT_ALERTS.some(a=>a.binId===binId) ? 55 : 10;

  const weights = {fill:0.30, risk:0.25, weight:0.15, time:0.15, alert:0.15};
  const total = Math.round(fillScore*weights.fill + riskScore*weights.risk + weightScore*weights.weight + timeScore*weights.time + alertScore*weights.alert);
  const label = total>=85?'CRITICAL':total>=65?'HIGH':total>=40?'MEDIUM':'LOW';
  return {
    binId, score: total, label,
    breakdown: [
      {factor:'Fill Level', value:`${s.fillLevel.toFixed(0)}%`, contribution:Math.round(fillScore*weights.fill)},
      {factor:'Overflow Risk', value:overflow.risk, contribution:Math.round(riskScore*weights.risk)},
      {factor:'Weight', value:`${s.weight}kg`, contribution:Math.round(weightScore*weights.weight)},
      {factor:'Time Since Collection', value:`${s.ticksSinceCollection} ticks`, contribution:Math.round(timeScore*weights.time)},
      {factor:'Alert Severity', value: IOT_ALERTS.some(a=>a.binId===binId)?'Active alert':'None', contribution:Math.round(alertScore*weights.alert)},
    ]
  };
}

// ---------- ROUTE OPTIMIZATION ENGINE ----------
const PROCESSING_FACILITY = {name:'Coimbatore Processing Facility', lat:11.0450, lng:76.9200};
const DEPOT = {name:'CLENVIRO Depot', lat:11.0168, lng:76.9558};

function routeOptimizationEngine(){
  TRUCKS.forEach(t=>{ t.currentLoadKg=0; t.assignedBins=[]; t.route=[]; t.status='AVAILABLE'; });
  const queue = BINS
    .map(b => ({bin:b, priority: collectionPriorityEngine(b.id)}))
    .filter(r => r.priority && r.priority.score >= 40)
    .sort((a,b) => b.priority.score - a.priority.score);

  const unassigned = [];
  queue.forEach(({bin, priority}) => {
    const s = IOT_STATE[bin.id];
    const weight = s.weight;
    let candidates = TRUCKS.filter(t => t.capacityKg - t.currentLoadKg >= weight);
    if(!candidates.length){ unassigned.push({bin, priority, reason:'CAPACITY EXCEEDED on all trucks'}); return; }
    candidates.sort((a,b) => {
      const da = citHaversineKm(a.latitude, a.longitude, BIN_COORDS[bin.loc]?.[0]||DEPOT.lat, BIN_COORDS[bin.loc]?.[1]||DEPOT.lng);
      const db = citHaversineKm(b.latitude, b.longitude, BIN_COORDS[bin.loc]?.[0]||DEPOT.lat, BIN_COORDS[bin.loc]?.[1]||DEPOT.lng);
      return da - db;
    });
    const truck = candidates[0];
    truck.assignedBins.push(bin.id);
    truck.currentLoadKg = +(truck.currentLoadKg + weight).toFixed(1);
    truck.status = 'ON ROUTE';
    const coords = BIN_COORDS[bin.loc] || [DEPOT.lat, DEPOT.lng];
    truck.route.push({binId:bin.id, location:bin.loc, lat:coords[0], lng:coords[1], priority:priority.score});
  });

  TRUCKS.forEach(t => {
    if(!t.route.length) return;
    // nearest-neighbour ordering from the truck's current position
    const stops = [...t.route]; const ordered = []; let cur = {lat:t.latitude, lng:t.longitude};
    while(stops.length){
      stops.sort((a,b)=>citHaversineKm(cur.lat,cur.lng,a.lat,a.lng) - citHaversineKm(cur.lat,cur.lng,b.lat,b.lng));
      const next = stops.shift(); ordered.push(next); cur = next;
    }
    t.route = ordered;
    let dist = citHaversineKm(t.latitude,t.longitude, ordered[0].lat, ordered[0].lng);
    for(let i=0;i<ordered.length-1;i++) dist += citHaversineKm(ordered[i].lat,ordered[i].lng, ordered[i+1].lat,ordered[i+1].lng);
    dist += citHaversineKm(ordered[ordered.length-1].lat, ordered[ordered.length-1].lng, PROCESSING_FACILITY.lat, PROCESSING_FACILITY.lng);
    t.estDistanceKm = +dist.toFixed(1);
    t.estTimeMin = Math.round(dist * 3.2 + ordered.length*6); // ~19km/h avg incl. stops, prototype constant
    t.capacityUtilPct = Math.round((t.currentLoadKg/t.capacityKg)*100);
  });

  return { trucks: TRUCKS.filter(t=>t.route.length), unassigned };
}

