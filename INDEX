function citDetectLocation(){
  const statusEl = document.getElementById('cit-location-status');
  if(!navigator.geolocation){
    if(statusEl) statusEl.textContent = '⚪ Geolocation not supported on this device — please select manually.';
    return;
  }
  if(statusEl) statusEl.textContent = '🟡 Requesting device location…';
  locationService.getCurrentLocation().then(({lat,lng}) => {
      const distKm = citHaversineKm(lat, lng, 11.0168, 76.9558); // Coimbatore approx centre
      if(distKm < 60){
        citizenLocation = { state:'Tamil Nadu', district:'Coimbatore', area:citizenLocation.area || 'Gandhipuram Bus Stand', source:'DEVICE LOCATION' };
        if(statusEl) statusEl.textContent = `🟢 Device location detected — near Coimbatore. Not exact GPS pinpointing.`;
      } else {
        citizenLocation.source = 'DEVICE LOCATION (outside demo coverage)';
        if(statusEl) statusEl.textContent = `🟡 Device location detected, but it's outside our current demo coverage area (Tamil Nadu). Showing manual selection instead.`;
      }
      citSyncSelectors();
      citRenderAll();
    }).catch(err => {
      const msg = err && err.code===1 ? 'Permission denied.' : err && err.code===2 ? 'Position unavailable.' : 'Request timed out or unsupported.';
      if(statusEl) statusEl.textContent = `⚪ ${msg} You can still select your area manually below.`;
    });
}
function citHaversineKm(lat1,lon1,lat2,lon2){
  const R=6371, dLat=(lat2-lat1)*Math.PI/180, dLon=(lon2-lon1)*Math.PI/180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2*Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
