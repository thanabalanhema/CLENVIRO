// ---------- DETERMINISTIC NEARBY BINS ----------
function citLocationCentroid(){
  if(citizenLocation.district === 'Coimbatore' && citizenLocation.area && BIN_COORDS[citizenLocation.area]){
    return BIN_COORDS[citizenLocation.area];
  }
  if(citizenLocation.district && GIS_TN_DISTRICTS){
    const feat = GIS_TN_DISTRICTS.features.find(f=>f.properties.name===citizenLocation.district);
    if(feat && typeof L !== 'undefined'){
      const c = L.geoJSON(feat).getBounds().getCenter();
      return [c.lat, c.lng];
    }
  }
  return [11.0168, 76.9558]; // Coimbatore fallback
}
function citGenerateNearbyBins(){
  const seedKey = (citizenLocation.area || citizenLocation.district || 'India') + '|bins';
  const rand = gisSeed(seedKey);
  const center = citLocationCentroid();
  const bins = [];
  // Phase 6: if the selected area has a real CLENVIRO bin with live IoT
  // simulation data, surface that actual shared state first (same data
  // Admin/GIS see) instead of only synthetic filler.
  const realBin = BINS.find(b => b.loc === citizenLocation.area);
  if(realBin && typeof IOT_STATE !== 'undefined' && IOT_STATE[realBin.id]){
    const s = IOT_STATE[realBin.id];
    bins.push({
      id: realBin.id, lat: s.latitude, lng: s.longitude,
      fill: Math.round(s.fillLevel), status: s.fillLevel>90?'critical':s.fillLevel>=70?'warning':'normal',
      wasteType: realBin.type, lastCollection: s.ticksSinceCollection < 4 ? 'Just now' : (s.ticksSinceCollection < 20 ? 'Today' : 'Yesterday'),
      live: true
    });
  }
  const n = 5 + Math.floor(rand()*4); // fill out the rest with synthetic nearby bins
  for(let i=0;i<n;i++){
    const fill = Math.round(rand()*100);
    const status = fill>90?'critical':fill>=70?'warning':'normal';
    bins.push({
      id: 'BIN-' + (citizenLocation.district||'IN').slice(0,3).toUpperCase() + '-' + String(100+i),
      lat: center[0] + (rand()-0.5)*0.018,
      lng: center[1] + (rand()-0.5)*0.018,
      fill, status,
      wasteType: ['Mixed','Organic','Recyclable','Paper'][Math.floor(rand()*4)],
      lastCollection: rand()>0.5 ? 'Today' : 'Yesterday',
      live: false
    });
  }
  return bins;
}

