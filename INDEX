        <div class="route-info"><div class="route-loc">${s.location}</div><div class="route-sub">${s.binId} · Priority ${s.priority}/100 ${i===r.currentIndex && r.started?' · NEXT STOP':''}</div></div>
      </div>`).join('')}
    ${r.started && !done ? `
      <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
        <button class="btn-sm btn-approve" onclick="aiDriverArrived()">📍 ARRIVED</button>
        <button class="btn-sm btn-approve" onclick="aiDriverCollected()">✅ COLLECTED</button>
        <button class="btn-sm btn-escalate" onclick="aiDriverSkip()">⏭ SKIP</button>
      </div>` : ''}
    ${r.started && done ? `<button class="btn-primary" style="width:auto;padding:8px 16px;font-size:12px;margin-top:10px;" onclick="aiDriverCompleteRoute()">🏁 COMPLETE ROUTE</button>` : ''}`;
}
function aiDriverStartRoute(){ aiDriverRoute.started = true; showToast('🚛','Route started'); aiRenderDriverRoute(); }
function aiDriverArrived(){ showToast('📍','Arrived at '+aiDriverRoute.stops[aiDriverRoute.currentIndex].location); }
function aiDriverCollected(){
  const stop = aiDriverRoute.stops[aiDriverRoute.currentIndex];
  if(!stop) return;
  const s = IOT_STATE[stop.binId];
  const truck = TRUCKS.find(t=>t.truckId===aiDriverRoute.truckId);
  if(s){
    if(truck) truck.currentLoadKg = Math.max(0, +(truck.currentLoadKg - s.weight).toFixed(1));
    s.fillLevel = 0; s.weight = 0; s.collectionRequired = false; s.ticksSinceCollection = 0;
  }
  iotSyncBinsArray();
  aiDriverRoute.currentIndex++;
  showToast('✅', stop.binId+' collected — bin reset to 0%');
  aiRenderDriverRoute();
  if(typeof iotRenderAll === 'function') iotRenderAll();
}
function aiDriverSkip(){
  const stop = aiDriverRoute.stops[aiDriverRoute.currentIndex];
  aiDriverRoute.currentIndex++;
  showToast('⏭', 'Skipped '+(stop?stop.binId:'stop'));
  aiRenderDriverRoute();
}
function aiDriverCompleteRoute(){
  const truck = TRUCKS.find(t=>t.truckId===aiDriverRoute.truckId);
  if(truck){ truck.status='AVAILABLE'; truck.route=[]; truck.assignedBins=[]; truck.currentLoadKg=0; }
  aiDriverRoute = { truckId:null, stops:[], currentIndex:0, started:false };
  showToast('🏁','Route complete');
  aiRenderDriverRoute();
  if(typeof aiRenderTruckPanel === 'function') aiRenderTruckPanel();
}

