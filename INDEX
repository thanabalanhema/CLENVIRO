<script>
(function(){
"use strict";
const P=window.CLENVIRO_PHASE_11_4_COMPLETE={version:"11.4"};

P.rules=[
 ["Admin","Operational resources","ALLOW","Full authorized administrative scope"],
 ["Driver","Assigned routes / tasks","ALLOW","Owner/assignment scoped"],
 ["Driver","Another driver's route/task","DENY","IDOR protection"],
 ["Citizen","Own reports/profile/location","ALLOW","Owner scoped"],
 ["Citizen","Another citizen's resource","DENY","IDOR protection"],
 ["Citizen","Admin resources","DENY","Role restriction"],
 ["Any","Role/owner/status injection","DENY","Server-controlled fields"]
];

P.authorize=function(ctx,resource,ownerId){
 if(!ctx||!ctx.authenticated)return {code:401,ok:false};
 const role=String(ctx.role||"").toLowerCase(), uid=String(ctx.userId||"");
 if(role==="admin")return {code:200,ok:true};
 if(role==="citizen" && ["own-reports","own-profile","own-location"].includes(resource) &&
    (!ownerId || uid===String(ownerId)))return {code:200,ok:true};
 if(role==="driver" && ["assigned-route","assigned-tasks","own-stats"].includes(resource) &&
    (!ownerId || uid===String(ownerId)))return {code:200,ok:true};
 return {code:403,ok:false};
};

P.validateMutation=function(data){
 const forbidden=["role","user_id","owner_id","approved_by","assigned_driver","is_admin",
                  "password_hash","session_id","status"];
 return forbidden.filter(k=>Object.prototype.hasOwnProperty.call(data||{},k));
};

P.render=function(){
 if(document.getElementById("cv114CompletePanel"))return;
 const host=document.querySelector("#usersessions")||document.querySelector("#overview")||document.querySelector(".page.active");
 if(!host)return;
 const root=document.createElement("div");
 root.id="cv114CompletePanel";
 root.innerHTML=`
