// ---------- WHAT-IF (operates on a clone — never touches real state) ----------
function aiRunWhatIf(){
  const trucks = +document.getElementById('wi-trucks').value || 5;
  const capacity = +document.getElementById('wi-capacity').value || 2500;
  const threshold = +document.getElementById('wi-threshold').value || 40;
  // Clone truck starting positions only (first N), run the same greedy
  // logic against a throwaway copy — real TRUCKS/BINS are never touched.
  const cloneTrucks = TRUCK_COORDS && Object.keys(TRUCK_COORDS).slice(0,trucks).map(id=>({truckId:id, capacityKg:capacity, currentLoadKg:0, latitude:TRUCK_COORDS[id][0], longitude:TRUCK_COORDS[id][1], route:[]}));
  const queue = BINS.map(b=>({bin:b, priority:collectionPriorityEngine(b.id)})).filter(r=>r.priority && r.priority.score>=threshold).sort((a,b)=>b.priority.score-a.priority.score);
  let remaining = 0;
  queue.forEach(({bin,priority})=>{
    const weight = IOT_STATE[bin.id]?.weight || 0;
    const candidate = cloneTrucks.filter(t=>t.capacityKg-t.currentLoadKg>=weight).sort((a,b)=>citHaversineKm(a.latitude,a.longitude,BIN_COORDS[bin.loc]?.[0]||11.02,BIN_COORDS[bin.loc]?.[1]||76.95)-citHaversineKm(b.latitude,b.longitude,BIN_COORDS[bin.loc]?.[0]||11.02,BIN_COORDS[bin.loc]?.[1]||76.95))[0];
    if(candidate){ candidate.currentLoadKg += weight; candidate.route.push(bin.id); } else remaining++;
  });
  const util = cloneTrucks.length ? Math.round(cloneTrucks.reduce((s,t)=>s+t.currentLoadKg,0)/(cloneTrucks.length*capacity)*100) : 0;
  document.getElementById('wi-results').innerHTML = `
    <div style="font-size:12px;line-height:1.8;">
      Expected routes: <b>${cloneTrucks.filter(t=>t.route.length).length}</b> of ${trucks} trucks used<br>
      Estimated capacity utilization: <b>${util}%</b><br>
      Priority-threshold bins queued: <b>${queue.length}</b><br>
      Bins left unassigned (capacity exceeded): <b>${remaining}</b>
    </div>
    <div class="source-meta" style="margin-top:6px;">This simulation does not change your real fleet/route data above.</div>`;
}

