      ${b.status === 'critical' ? `<div class="bin-actions"><button class="btn-xs btn-red" onclick="showToast('🚛','Truck dispatched to ${b.loc}!')">Dispatch</button><button class="btn-xs btn-teal" onclick="showToast('📊','Viewing ${b.id} details!')">Details</button></div>` : ''}
