let map = null, gisStatesLayer = null, gisDistrictsLayer = null, gisBinsLayer = null, gisTrucksLayer = null;
let gisLevel = 'india';
let gisSelectedDistrict = null;

// ============ GIS: INIT & NAVIGATION ============
function gisInitMap(){
  if(map) return; // already initialized
  if(typeof L === 'undefined'){
    document.getElementById('leaflet-map').innerHTML = '<div style="padding:20px;font-size:12px;color:var(--text2);">GIS map library could not be loaded (no internet connection to CDN). Reconnect and reload to view the map.</div>';
    return;
  }
  map = L.map('leaflet-map', {zoomControl:false, attributionControl:true, minZoom:4, maxZoom:14})
        .setView([22.9,80], 4.4);
  L.control.zoom({position:'topright'}).addTo(map);
  map.attributionControl.setPrefix('Leaflet · Boundaries: udit-001/india-maps-data');
  gisRenderIndia();
  setTimeout(()=>map.invalidateSize(), 100);
}

function gisClearBoundaryLayers(){
  if(gisStatesLayer){ map.removeLayer(gisStatesLayer); gisStatesLayer=null; }
  if(gisDistrictsLayer){ map.removeLayer(gisDistrictsLayer); gisDistrictsLayer=null; }
}

function gisRenderIndia(){
  if(!map) return;
  gisClearBoundaryLayers();
  gisLevel = 'india';
  gisSelectedDistrict = null;
  document.getElementById('gis-level-label').textContent = 'India';
  gisUpdateBreadcrumb();
  gisHideInfoPanel();
  gisStatesLayer = L.geoJSON(GIS_INDIA_STATES, {
    style: f => {
      const d = stateWasteLookup(f.properties.name);
      const rate = d ? d.collectionPct : null;
      return {
        color: f.properties.name==='Tamil Nadu' ? '#0891b2' : '#2563eb',
        weight: f.properties.name==='Tamil Nadu' ? 2.5 : 1,
        fillColor: wasteMapColor(rate),
        fillOpacity: rate == null ? 0.20 : 0.55
      };
    },
    onEachFeature: (feature, layer) => {
      const d = stateWasteLookup(feature.properties.name);
      const rateText = d ? wasteRateLabel(d.collectionPct) : 'Data unavailable';
      layer.bindTooltip(
        `<b>${feature.properties.name}</b><br>Collection: ${rateText}`,
        {sticky:true}
      );
      layer.on('mouseover', () => layer.setStyle({weight:3, fillOpacity:.72}));
      layer.on('mouseout', () => gisStatesLayer.resetStyle(layer));
      layer.on('click', () => {
        if(d) showStateWasteInfo(feature.properties.name);
        else showToast('🇮🇳', feature.properties.name + ' — official state waste data unavailable in this imported dataset');
        if(feature.properties.name === 'Tamil Nadu') gisRenderTamilNadu();
      });
    }
  }).addTo(map);
  map.setView([22.9,80], 4.4);
  gisRenderBinTruckLayers(false);
}
function gisRenderTamilNadu(){
  if(!map) return;
  gisClearBoundaryLayers();
  gisLevel = 'tamilnadu';
  gisSelectedDistrict = null;
  document.getElementById('gis-level-label').textContent = 'Tamil Nadu';
  gisUpdateBreadcrumb();
  gisHideInfoPanel();
  gisDistrictsLayer = L.geoJSON(GIS_TN_DISTRICTS, {
    style: f => ({
      color: f.properties.name==='Coimbatore' ? '#00e5ff' : '#00d4aa',
      weight: f.properties.name==='Coimbatore' ? 2.5 : 1,
      fillColor: f.properties.name==='Coimbatore' ? '#00e5ff' : '#0d3b52',
      fillOpacity: f.properties.name==='Coimbatore' ? 0.4 : 0.25
    }),
    onEachFeature: (feature, layer) => {
      layer.bindTooltip(feature.properties.name, {sticky:true});
      layer.on('mouseover', () => layer.setStyle({weight:3}));
      layer.on('mouseout', () => gisDistrictsLayer.resetStyle(layer));
      layer.on('click', () => gisSelectDistrict(feature.properties.name, layer));
    }
  }).addTo(map);
  try{ map.fitBounds(gisDistrictsLayer.getBounds(), {padding:[16,16]}); }catch(e){}
  gisRenderBinTruckLayers(false);
}

function gisSelectDistrict(name, layer){
  gisLevel = 'district';
  gisSelectedDistrict = name;
  document.getElementById('gis-level-label').textContent = name;
  gisUpdateBreadcrumb();
  try{ map.fitBounds(layer.getBounds(), {padding:[30,30], maxZoom:12}); }catch(e){}
  gisShowInfoPanel(name);
  gisRenderBinTruckLayers(name === 'Coimbatore');
}

function gisUpdateBreadcrumb(){
  let html = `<span class="crumb${gisLevel==='india'?' active':''}" onclick="gisRenderIndia()">🇮🇳 India</span>`;
  if(gisLevel==='tamilnadu' || gisLevel==='district'){
    html += `<span class="crumb-sep">/</span><span class="crumb${gisLevel==='tamilnadu'?' active':''}" onclick="gisRenderTamilNadu()">Tamil Nadu</span>`;
  }
  if(gisLevel==='district'){
    html += `<span class="crumb-sep">/</span><span class="crumb active">${gisSelectedDistrict}</span>`;
  }
  document.getElementById('gis-breadcrumb').innerHTML = html;
}

// ============ GIS: BIN & TRUCK MARKERS ============
function gisRenderBinTruckLayers(show){
  if(!map) return;
  if(gisBinsLayer){ map.removeLayer(gisBinsLayer); gisBinsLayer=null; }
  if(gisTrucksLayer){ map.removeLayer(gisTrucksLayer); gisTrucksLayer=null; }
  if(!show) return;

  gisBinsLayer = L.layerGroup();
  BINS.forEach(b => {
    const coords = BIN_COORDS[b.loc];
    if(!coords) return;
    const iot = (typeof IOT_STATE !== 'undefined') ? IOT_STATE[b.id] : null;
    const offline = iot && !iot.online;
    const color = offline ? '#475569' : b.status==='critical' ? '#ff1744' : b.status==='warning' ? '#ffd600' : '#00e676';
    const marker = L.circleMarker(coords, {radius:9, color:'#0a1628', weight:2, fillColor:color, fillOpacity:0.95});
    const sensorLines = iot ? `Battery: <b>${iot.batteryLevel.toFixed(0)}%</b> · Signal: <b>${offline?'Offline':iot.signalStrength}</b><br>Health: <b>${iotHealthScore(iot).score}/100</b> (${iotHealthScore(iot).label})<br>` : '';
    const priority = (typeof collectionPriorityEngine === 'function') ? collectionPriorityEngine(b.id) : null;
    const overflow = (typeof predictiveOverflowEngine === 'function') ? predictiveOverflowEngine(b.id) : null;
    const aiLines = priority && overflow ? `Priority: <b>${priority.score}/100</b> (${priority.label}) · Risk: <b>${overflow.risk}</b><br>${overflow.offline?'Prediction unavailable (offline)':overflow.recommendation}<br>` : '';
    marker.bindPopup(
      `<b>${b.id}</b> — ${b.loc}<br>Fill level: <b>${b.fill}%</b> (${offline?'offline':b.status})<br>${sensorLines}${aiLines}${b.ai}<br>` +
      `<span style="font-size:10px;opacity:.65;">${iot?'🟡 PROTOTYPE IoT DATA — simulated sensor':'🟣 CLENVIRO DEMO DATA'}</span>` +
      (iot ? `<br><a onclick="showPage('iot');setTimeout(()=>iotRenderDetail('${b.id}'),60)" style="color:#00d4aa;cursor:pointer;font-size:11px;">View live sensor detail →</a>` : '') +
      (priority ? `<br><a onclick="showPage('ai');setTimeout(()=>aiShowWhy('${b.id}'),60)" style="color:#00d4aa;cursor:pointer;font-size:11px;">Why this priority? →</a>` : '')
    );
    marker.addTo(gisBinsLayer);
  });
  gisBinsLayer.addTo(map);

  gisTrucksLayer = L.layerGroup();
  Object.entries(TRUCK_COORDS).forEach(([id, coords]) => {
    const icon = L.divIcon({html:'🚛', className:'leaflet-truck-icon', iconSize:[22,22]});
    const t = (typeof TRUCKS !== 'undefined') ? TRUCKS.find(x=>x.truckId===id) : null;
    const marker = L.marker(t ? [t.latitude,t.longitude] : coords, {icon});
    const fleetLines = t ? `Driver: <b>${t.driver}</b><br>Capacity: <b>${t.capacityKg}kg</b> · Load: <b>${t.currentLoadKg}kg</b><br>Stops: <b>${t.route.length}</b> · Efficiency: <b>${t.capacityUtilPct||0}%</b><br>` : 'Status: En route<br>';
    marker.bindPopup(`<b>${id}</b><br>${fleetLines}<span style="font-size:10px;opacity:.65;">🟣 DEMO GPS — not a live location feed</span>` + (t?`<br><a onclick="showPage('ai')" style="color:#00d4aa;cursor:pointer;font-size:11px;">View AI Operations →</a>`:''));
    marker.addTo(gisTrucksLayer);
  });
  gisTrucksLayer.addTo(map);
}

// ============ GIS: INFO PANEL ============
function gisShowInfoPanel(district){
  const panel = document.getElementById('gis-info-panel');
  const isCbe = district === 'Coimbatore';
  const binCount = isCbe ? BINS.length : 0;
  const criticalCount = isCbe ? BINS.filter(b=>b.status==='critical').length : 0;
  const truckCount = isCbe ? Object.keys(TRUCK_COORDS).length : 0;
  panel.innerHTML = `
    <div class="card-header" style="margin-bottom:12px;">
      <span class="card-title">📍 ${district} District</span>
      <span class="map-filter-btn" onclick="gisHideInfoPanel()">✕ Close</span>
