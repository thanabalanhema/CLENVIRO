   </div>
   <div style="margin-top:16px"><b>Authorization self-test</b>
   <div class="cv114-muted" style="margin:5px 0 10px">These tests validate the frontend authorization contract. Production enforcement must also exist in the backend API.</div>
   <div id="cv114Results"></div>
   <button class="cv114-btn" id="cv114RunTests">Run security tests</button>
   <button class="cv114-btn alt" id="cv114ClearTests">Clear</button>
   </div>
 </div>`;
 host.appendChild(root);

 const run=root.querySelector("#cv114RunTests");
 run.onclick=function(){
   const tests=[
    ["Unauthenticated → 401",P.authorize({authenticated:false},"admin").code===401],
    ["Admin → fleet allowed",P.authorize({authenticated:true,role:"admin",userId:"A1"},"fleet").code===200],
    ["Citizen → own report allowed",P.authorize({authenticated:true,role:"citizen",userId:"C1"},"own-reports","C1").code===200],
    ["Citizen → another report denied",P.authorize({authenticated:true,role:"citizen",userId:"C1"},"own-reports","C2").code===403],
    ["Driver → own task allowed",P.authorize({authenticated:true,role:"driver",userId:"D1"},"assigned-tasks","D1").code===200],
    ["Driver → another task denied",P.authorize({authenticated:true,role:"driver",userId:"D1"},"assigned-tasks","D2").code===403],
    ["Citizen → admin resource denied",P.authorize({authenticated:true,role:"citizen",userId:"C1"},"users").code===403],
    ["Mass assignment denied",P.validateMutation({role:"admin",owner_id:"A1",status:"approved"}).length>0],
    ["Password hash mutation denied",P.validateMutation({password_hash:"x"}).length>0]
   ];
   root.querySelector("#cv114Results").innerHTML=tests.map(t=>`<div style="padding:7px 0;border-bottom:1px solid rgba(148,163,184,.1)">
   <span class="cv114-pill ${t[1]?"cv114-ok":"cv114-bad"}">${t[1]?"PASS":"FAIL"}</span> ${t[0]}</div>`).join("");
 };
 root.querySelector("#cv114ClearTests").onclick=()=>root.querySelector("#cv114Results").innerHTML="";
};
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",()=>setTimeout(P.render,500));
else setTimeout(P.render,500);
})();
