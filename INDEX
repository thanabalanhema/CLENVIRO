function buildBinGrid() {
  const grid = document.getElementById('bin-grid');
  if(!grid) return;
  grid.innerHTML = BINS.map(b => {
    const fillClass = b.fill >= 90 ? 'fill-red' : b.fill >= 70 ? 'fill-yellow' : 'fill-green';
    const cardClass = b.status;
    return `<div class="bin-card ${cardClass}">
      <div class="bin-top">
        <div><div class="bin-id">${b.id}</div><div class="bin-loc">${b.loc}</div></div>
        <span class="status-chip ${b.status==='critical'?'sc-red':b.status==='warning'?'sc-yellow':'sc-green'}">${b.fill}%</span>
      </div>
      <div class="bin-fill-bar"><div class="bin-fill-inner ${fillClass}" style="width:${b.fill}%"></div></div>
      <div class="bin-stats">
        <span class="bin-stat">🗑 ${b.type}</span>
        <span class="bin-stat">⏱ ${b.last}</span>
        ${b.truck !== '–' ? `<span class="bin-stat">🚛 ${b.truck}</span>` : ''}
        ${b.eta !== '–' ? `<span class="bin-stat">📍 ETA ${b.eta}</span>` : ''}
