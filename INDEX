}
function aiRenderDriverRoute(){
  const el = document.getElementById('driver-ai-route');
  if(!el) return;
  if(!aiDriverRoute.truckId || !aiDriverRoute.stops.length){
    el.innerHTML = '<div style="font-size:12px;color:var(--text2);">No AI-optimized route assigned yet — run optimization from the AI Operations Center.</div>';
    return;
  }
  const r = aiDriverRoute;
  const done = r.currentIndex >= r.stops.length;
  el.innerHTML = `
    <div class="source-meta" style="margin-bottom:8px;">🤖 AI PROTOTYPE ROUTE — ${r.truckId} · ${r.stops.length} stops · Est. ${r.estDistanceKm}km / ${r.estTimeMin}min · Capacity ${r.capacityUtilPct}%</div>
