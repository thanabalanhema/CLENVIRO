// District/state size class -> baseline operational assumptions
function gisSizeClass(pop){
  if(pop >= 4000000) return {cls:'Metropolitan', efficiency:92, recycling:35, complaintRate:0.00006, overflowRate:0.00002, responseTimeMin:16};
  if(pop >= 1500000) return {cls:'Large Urban', efficiency:87, recycling:28, complaintRate:0.00008, overflowRate:0.00003, responseTimeMin:22};
  if(pop >= 500000)  return {cls:'Medium Urban', efficiency:80, recycling:22, complaintRate:0.00011, overflowRate:0.00005, responseTimeMin:30};
  if(pop >= 150000)  return {cls:'Small Urban', efficiency:74, recycling:16, complaintRate:0.00014, overflowRate:0.00007, responseTimeMin:38};
  return {cls:'Predominantly Rural', efficiency:65, recycling:10, complaintRate:0.00018, overflowRate:0.00010, responseTimeMin:52};
}

// Deterministic seeded PRNG (mulberry32) — same name+day always -> same value.
// Avoids Math.random() so results are reproducible across re-renders.
function gisSeed(str){
  let h = 1779033703 ^ str.length;
  for(let i=0;i<str.length;i++){
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  return function(){
    h = Math.imul(h ^ (h >>> 16), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    h = (h ^= h >>> 16) >>> 0;
    return h / 4294967296;
  };
}

// Baseline (non-time-varying) assumption record for one location.
function generateLocationBaseline(name, population){
  const sc = gisSizeClass(population);
  const F = ASSUMPTION_FACTORS;
  const dailyWasteKg = population * F.wasteGenPerCapitaKg;
  const dailyWasteTonnes = dailyWasteKg / 1000;
  const households = Math.round(population / 4.2);
  const smartBins = Math.max(1, Math.round(population / F.personsPerSmartBin));
  const dailyCollectionCapacity = dailyWasteTonnes * (sc.efficiency/100);
  const vehicles = Math.max(1, Math.ceil(dailyCollectionCapacity / F.vehicleCapacityTonnes));
  const facilities = Math.max(1, Math.round(population / F.personsPerFacility));
  return {
    name, population, households, sizeClass: sc.cls,
    dailyWasteTonnes, smartBins, vehicles, facilities,
    baseEfficiency: sc.efficiency, baseRecycling: sc.recycling,
    complaintRate: sc.complaintRate, overflowRate: sc.overflowRate,
    baseResponseTimeMin: sc.responseTimeMin,
    composition: F.composition,
    dataSource: 'CLENVIRO ASSUMPTION DATA', modelVersion: ASSUMPTION_MODEL_VERSION
  };
}

// Time-series generator: `days` daily records with gradual, deterministic
// variation (weekday pattern + slow trend + seeded jitter) — not pure noise.
function generateTimeSeries(baseline, days){
  const rand = gisSeed(baseline.name + '|' + days);
  const series = [];
  const today = new Date('2026-08-19T00:00:00Z');
  let effTrend = 0, recTrend = 0;
  for(let i=days-1;i>=0;i--){
    const d = new Date(today); d.setUTCDate(d.getUTCDate()-i);
    const dow = d.getUTCDay(); // 0=Sun..6=Sat
    const weekendBoost = (dow===0||dow===6) ? 1.12 : 1.0; // more waste on weekends
    const dayIdx = days-1-i;
    effTrend += (rand()-0.42) * 0.35;   // slow drift, biased slightly upward
    recTrend += (rand()-0.40) * 0.30;
    effTrend = Math.max(-8, Math.min(8, effTrend));
    recTrend = Math.max(-6, Math.min(10, recTrend));

    const wasteGenerated = baseline.dailyWasteTonnes * weekendBoost * (0.94 + rand()*0.12);
    const efficiency = Math.max(45, Math.min(99, baseline.baseEfficiency + effTrend + (rand()-0.5)*3));
    const wasteCollected = wasteGenerated * (efficiency/100);
    const recyclingRate = Math.max(4, Math.min(60, baseline.baseRecycling + recTrend + (rand()-0.5)*2));
    const recycled = wasteCollected * (recyclingRate/100);
    const overflow = Math.round(baseline.population * baseline.overflowRate * (0.5 + rand()*1.2) * (dow===0||dow===6?1.3:1));
    const complaints = Math.round(baseline.population * baseline.complaintRate * (0.6 + rand()*1.0));
    const responseTime = Math.max(6, baseline.baseResponseTimeMin - (effTrend*0.6) + (rand()-0.5)*4);
    const vehicleUtilPct = Math.max(40, Math.min(98, efficiency - 3 + (rand()-0.5)*8));
    const co2Saved = recycled * ASSUMPTION_FACTORS.co2SavedPerTonneRecycled;

    series.push({
      date: d.toISOString().slice(0,10),
      dayIndex: dayIdx,
      wasteGenerated: +wasteGenerated.toFixed(2),
      wasteCollected: +wasteCollected.toFixed(2),
      collectionEfficiency: +efficiency.toFixed(1),
      recyclingRate: +recyclingRate.toFixed(1),
      recycled: +recycled.toFixed(2),
      overflowIncidents: overflow,
      complaints: complaints,
      avgResponseTimeMin: +responseTime.toFixed(1),
      vehicleUtilizationPct: +vehicleUtilPct.toFixed(1),
      co2SavedTonnes: +co2Saved.toFixed(2)
    });
  }
  return series;
}

// Full record (baseline + time series) for one location + period.
function getAssumptionData(name, population, days){
  const baseline = generateLocationBaseline(name, population);
  const series = generateTimeSeries(baseline, days);
  return { baseline, series };
}

// Aggregate a set of {name,population} locations into one combined series
// (population-weighted sums for absolute metrics, weighted averages for %).
function aggregateAssumptionData(locations, days, label){
  const records = locations.map(l => getAssumptionData(l.name, l.population, days));
  const totalPop = locations.reduce((s,l)=>s+l.population,0);
  const series = [];
  for(let i=0;i<days;i++){
    const rows = records.map(r=>r.series[i]);
    const sum = k => rows.reduce((s,r)=>s+r[k],0);
    const wavg = k => rows.reduce((s,r,idx)=>s + r[k]*locations[idx].population,0) / totalPop;
    series.push({
      date: rows[0].date, dayIndex: rows[0].dayIndex,
      wasteGenerated: +sum('wasteGenerated').toFixed(2),
      wasteCollected: +sum('wasteCollected').toFixed(2),
      collectionEfficiency: +wavg('collectionEfficiency').toFixed(1),
      recyclingRate: +wavg('recyclingRate').toFixed(1),
      recycled: +sum('recycled').toFixed(2),
      overflowIncidents: sum('overflowIncidents'),
      complaints: sum('complaints'),
      avgResponseTimeMin: +wavg('avgResponseTimeMin').toFixed(1),
      vehicleUtilizationPct: +wavg('vehicleUtilizationPct').toFixed(1),
      co2SavedTonnes: +sum('co2SavedTonnes').toFixed(2)
    });
  }
  const baselineAgg = {
    name: locations.length>1 ? label : locations[0].name,
    population: totalPop,
    households: Math.round(totalPop/4.2),
    smartBins: records.reduce((s,r)=>s+r.baseline.smartBins,0),
    vehicles: records.reduce((s,r)=>s+r.baseline.vehicles,0),
    facilities: records.reduce((s,r)=>s+r.baseline.facilities,0),
    composition: ASSUMPTION_FACTORS.composition,
    dataSource: 'CLENVIRO ASSUMPTION DATA', modelVersion: ASSUMPTION_MODEL_VERSION
  };
  return { baseline: baselineAgg, series, memberCount: locations.length };
}

