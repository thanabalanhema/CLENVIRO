// ============ LOGIN ============
async function doLogin() {
  const u = document.getElementById('login-user').value.trim();
  const p = document.getElementById('login-pass').value.trim();
  const err = document.getElementById('login-error');
  const c = CREDS[currentRole];

  if(CLENVIRO_API_BASE_URL && typeof ApiDataProvider !== 'undefined'){
    try{
      const result = await ApiDataProvider.login(u,p);
      const user = result && result.user ? result.user : result;
      if(!user || !user.role) throw new Error('Backend login response missing user role');
      const backendRole = String(user.role).toLowerCase();
      if(backendRole !== currentRole){
        throw new Error('Selected role does not match authenticated account role');
      }
      const sessionUser = {
        role: backendRole,
        name: user.name || user.username || u,
        avatar: backendRole==='admin' ? '👨‍💼' : backendRole==='driver' ? '🚛' : '🌱',
        id: user.id || user.userId || u,
        username: user.username || u
      };
      window.CLENViroCurrentUser = sessionUser;
      err.style.display='none';
      document.getElementById('login-screen').style.display='none';
      document.getElementById('app').style.display='block';
      initApp(sessionUser);
      return;
    }catch(e){
      console.error('LIVE authentication failed', e);
      err.textContent='❌ Live backend login failed. Check credentials or backend connection.';
      err.style.display='block';
      document.getElementById('login-pass').style.borderColor='var(--red)';
      return;
    }
  }

  // Explicit DEMO mode only: no apiBase means local prototype credentials.
  if(!c || u !== currentRole || p !== c.pass) {
    err.textContent='❌ Invalid demo credentials. Try again.';
    err.style.display='block';
    document.getElementById('login-pass').style.borderColor='var(--red)';
    return;
  }
  err.textContent='❌ Invalid credentials. Try again.';
  err.style.display='none';
  window.CLENViroCurrentUser = c;
  document.getElementById('login-screen').style.display='none';
  document.getElementById('app').style.display='block';
  initApp(c);
}

