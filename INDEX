 try{
   if(typeof SIDEBARS!=='undefined' && SIDEBARS.admin && !SIDEBARS.admin.some(x=>x.id==='panchayat')){
     SIDEBARS.admin.push({id:'panchayat',icon:'🏛️',label:'Panchayat Portal'});
