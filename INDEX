function iotSetSort(key){ iotSortKey = key; iotRenderTable(); }
function iotRenderTable(){
  const el = document.getElementById('iot-bin-table-body');
  if(!el) return;
  let rows = BINS.map(bin => ({bin, s:IOT_STATE[bin.id]})).filter(r=>r.s);
  const sortFns = {
    fill:(a,b)=>b.s.fillLevel-a.s.fillLevel, battery:(a,b)=>a.s.batteryLevel-b.s.batteryLevel,
    location:(a,b)=>a.bin.loc.localeCompare(b.bin.loc), waste:(a,b)=>a.bin.type.localeCompare(b.bin.type),
