// ============ SIMULATION ============
function startSimulation() {
  // Move trucks
  setInterval(() => {
    ['truck1','truck2','truck3'].forEach(id => {
      const el = document.getElementById(id);
      if(!el) return;
      const t = parseFloat(el.style.top) + (Math.random()-0.5)*2;
      const l = parseFloat(el.style.left) + (Math.random()-0.5)*2;
      el.style.top = Math.max(10,Math.min(85,t))+'%';
      el.style.left = Math.max(10,Math.min(85,l))+'%';
    });
  }, 3000);

  // Update bin fills
  setInterval(() => {
    BINS.forEach((b, i) => {
      if(b.status === 'normal') return;
      b.fill = Math.min(100, b.fill + Math.floor(Math.random()*2));
      const grid = document.getElementById('bin-grid');
      if(grid) {
        const cards = grid.querySelectorAll('.bin-card');
        if(cards[i]) {
          const chip = cards[i].querySelector('.status-chip');
          const bar = cards[i].querySelector('.bin-fill-inner');
          if(chip) chip.textContent = b.fill+'%';
          if(bar) bar.style.width = b.fill+'%';
        }
      }
    });
    // Update KPI
    const crit = document.getElementById('kpi-critical');
    if(crit) crit.textContent = BINS.filter(b=>b.fill>=90).length;
  }, 5000);
}

